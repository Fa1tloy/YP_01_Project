@page
@model WebReckrytingSystem.Pages.IndexModel
@{
    ViewData["Title"] = "Твоя Карьера";
    Layout = "_Layout";
}

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="hero-overlay"></div>

    <!-- HERO CONTENT -->
    <div class="hero-content text-center text-white">
        <h1 class="hero-title">Вакансии для студентов</h1>
        <p class="hero-subtitle">Компании и вакансии размещает администратор, а соискатели общаются по откликам с администратором платформы</p>
        <div class="hero-buttons">
            @if (!User.Identity?.IsAuthenticated ?? false)
            {
                <a href="/Account/Register?role=job_seeker" class="btn btn-student me-3">
                    <i class="fas fa-user-graduate me-2"></i>Найти работу
                </a>
                <a href="/Vacancy/Search" class="btn btn-employer">
                    <i class="fas fa-search me-2"></i>Смотреть вакансии
                </a>
            }
        </div>
    </div>
</section>

<!-- USERS SECTION -->
<section class="users-section py-5">
    <div class="container">
        <div class="row g-4">
            <!-- STUDENT CARD -->
            <div class="col-md-6">
                <div class="user-card student-card">
                    <div class="card-header">
                        <i class="fas fa-user-graduate"></i>
                        <h3>Для студентов</h3>
                    </div>
                    <div class="card-body">
                        <p class="mb-4">Начните карьеру с практики и стажировки. Подберите подходящую вакансию.</p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check-circle"></i> Быстрая регистрация</li>
                            <li><i class="fas fa-check-circle"></i> Создание профессионального резюме</li>
                            <li><i class="fas fa-check-circle"></i> Отклик на вакансии в 1 клик</li>
                            <li><i class="fas fa-check-circle"></i> Только проверенные компании</li>
                        </ul>
                        
                    </div>
                </div>
            </div>

            <!-- EMPLOYER CARD -->
            <div class="col-md-6">
                <div class="user-card employer-card">
                    <div class="card-header">
                        <i class="fas fa-building"></i>
                        <h3>Для работодателей</h3>
                    </div>
                    <div class="card-body">
                        <p class="mb-4">Передайте информацию администратору платформы — он создаст компанию и опубликует вакансию.</p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check-circle"></i> Централизованная модерация компаний</li>
                            <li><i class="fas fa-check-circle"></i> Публикация вакансий администратором</li>
                            <li><i class="fas fa-check-circle"></i> Проверенная информация для соискателей</li>
                            <li><i class="fas fa-check-circle"></i> Общение по откликам через администратора</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="how-section py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Как это работает</h2>
            <p class="section-subtitle">3 простых шага к успеху</p>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h4>Создание профиля</h4>
                    <p>Зарегистрируйтесь и заполните контактную информацию</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h4>Поиск вакансии</h4>
                    <p>Используя фильтры и ключевые слова начните искать подходящие для вас вакансии</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h4>Отклик</h4>
                    <p>Отправьте созданное вами резюме и ожидайте на него ответа от работодателей после отклика на вакансию</p>
                </div>
            </div>
        </div>
    </div>
</section>