@page
@model WebReckrytingSystem.Pages.IndexModel
@{
    ViewData["Title"] = "RecruitingSystem";
}

<section class="hero-section min-vh-100 d-flex align-items-center">
    <div class="container text-center text-white">
        <h1 class="display-3 fw-bold mb-3 animate__animated animate__fadeInDown">Найдите работу мечты</h1>
        <p class="lead mb-4 animate__animated animate__fadeInUp">Или идеального сотрудника. Быстро. Просто. Эффективно.</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap animate__animated animate__fadeInUp animate__delay-1s">
            <a asp-page="/Account/Register" asp-route-role="job_seeker" class="btn btn-light btn-lg px-4 py-3 fw-600 rounded-pill">
                🎯 Найти работу
            </a>
            <a asp-page="/Account/Register" asp-route-role="employer" class="btn btn-outline-light btn-lg px-4 py-3 fw-600 rounded-pill">
                💼 Найти сотрудников
            </a>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Почему выбирают нас</h2>
            <p class="text-muted">Современная платформа для поиска работы и талантов</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-lg h-100 text-center p-4">
                    <div class="mb-3"><i class="fas fa-brain fa-3x text-primary"></i></div>
                    <h5 class="fw-bold">Умный поиск</h5>
                    <p class="text-muted">ИИ подбирает вакансии и кандидатов под ваши критерии</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-lg h-100 text-center p-4">
                    <div class="mb-3"><i class="fas fa-rocket fa-3x text-success"></i></div>
                    <h5 class="fw-bold">2 минуты до старта</h5>
                    <p class="text-muted">Регистрация и первый шаг к успеху — быстрее, чем кофе остынет</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-lg h-100 text-center p-4">
                    <div class="mb-3"><i class="fas fa-shield-alt fa-3x text-info"></i></div>
                    <h5 class="fw-bold">Безопасность</h5>
                    <p class="text-muted">Ваши данные защищены по стандартам GDPR</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Как это работает</h2>
            <p class="text-muted">3 простых шага к успеху</p>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="step-circle mx-auto mb-3">1</div>
                <h5>Регистрация</h5>
                <p class="text-muted">Создайте аккаунт за 60 секунд</p>
            </div>
            <div class="col-md-4">
                <div class="step-circle mx-auto mb-3">2</div>
                <h5>Профиль</h5>
                <p class="text-muted">Заполните информацию о себе / компании</p>
            </div>
            <div class="col-md-4">
                <div class="step-circle mx-auto mb-3">3</div>
                <h5>Старт</h5>
                <p class="text-muted">Начните поиск работы или талантов</p>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-6 col-md-3">
                <div class="display-5 fw-bold text-primary">500+</div>
                <div class="text-muted">Компаний</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="display-5 fw-bold text-success">10K+</div>
                <div class="text-muted">Соискателей</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="display-5 fw-bold text-info">2K+</div>
                <div class="text-muted">Вакансий</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="display-5 fw-bold text-warning">95%</div>
                <div class="text-muted">Успешных наймов</div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-primary text-white text-center">
    <div class="container">
        <h2 class="fw-bold mb-3">Готовы начать?</h2>
        <p class="lead mb-4">Присоединяйтесь к тысячам успешных компаний и соискателей</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-page="/Account/Register" asp-route-role="job_seeker" class="btn btn-light btn-lg px-5 py-3 fw-600 rounded-pill">🎯 Найти работу</a>
            <a asp-page="/Account/Register" asp-route-role="employer" class="btn btn-outline-light btn-lg px-5 py-3 fw-600 rounded-pill">💼 Найти сотрудников</a>
        </div>
    </div>
</section>

<style>
    .hero-section {
        background: var(--primary-gradient);
    }

    .step-circle {
        width: 70px;
        height: 70px;
        background: var(--primary-gradient);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        font-weight: 600;
    }

    .card {
        transition: var(--transition);
    }

        .card:hover {
            transform: translateY(-5px);
        }
</style>