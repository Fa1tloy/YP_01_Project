@using System.Security.Claims
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Твоя Карьера</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

    <!-- ТОЛЬКО НУЖНЫЕ СТИЛИ -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- НОВЫЙ ДИЗАЙН -->
    <link rel="stylesheet" href="~/css/careerflow.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
                    <span class="logo-text">Твоя Карьера</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" href="/">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Vacancy/Search">Поиск вакансий</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Register">Регистрация</a>
                        </li>
                    </ul>

                    <div class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <span class="nav-item nav-link text-dark">Привет, @User.FindFirst(ClaimTypes.GivenName)?.Value!</span>
                            <form method="post" asp-page="/Account/Logout" class="nav-item">
                                <button type="submit" class="btn btn-login">Выйти</button>
                            </form>
                        }
                        else
                        {
                            <a href="/Account/Login" class="btn btn-login">Войти</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer py-5">
        <div class="container">
            <div class="row">
                <!-- ЛОГОТИП В ФУТЕРЕ -->
                <div class="col-md-4 mb-4">
                    <a class="footer-brand d-flex align-items-center mb-3" href="/">
                        <img src="~/images/logotip.png" alt="Твоя Карьера" class="footer-logo me-2" />
                        <span class="footer-brand-text">Твоя Карьера</span>
                    </a>
                    <p class="text-muted">Лучшая платформа для поиска работы и талантов</p>
                </div>

                <!-- Остальные колонки -->
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Для студентов</h6>
                    <ul class="list-unstyled">
                        <li><a href="/Vacancy/Search">Поиск вакансий</a></li>
                        <li><a href="/Account/CreateResume">Создать резюме</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Для работодателей</h6>
                    <ul class="list-unstyled">
                        <li><a href="/Account/Register?role=employer">Разместить вакансию</a></li>
                        <li><a href="/Vacancy/Search">Найти сотрудников</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">О нас</h6>
                    <ul class="list-unstyled">
                        <li><a href="#">Контакты</a></li>
                        <li><a href="#">Помощь</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Соцсети</h6>
                    <div class="social-links">
                        <a href="#"><i class="fab fa-vk"></i></a>
                        <a href="#"><i class="fab fa-telegram"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>
            <hr>
            <div class="text-center">
                <p class="mb-0">&copy; 2025 Твоя Карьера. Все права защищены.</p>
            </div>
        </div>
    </footer>

    <!-- ТОЛЬКО НУЖНЫЕ СКРИПТЫ -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/modern.js" asp-append-version="true"></script>

    <!-- TOAST CONTAINER -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
        <div id="liveToast" class="toast" role="alert">
            <div class="toast-header">
                <strong class="me-auto text-primary">Твоя Карьера</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="toastMessage"></div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Активация toasts
        function showToast(message, type = 'success') {
            const toast = new bootstrap.Toast(document.getElementById('liveToast'));
            const toastBody = document.getElementById('toastMessage');
            toastBody.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle text-success' : 'exclamation-circle text-danger'} me-2"></i>${message}`;
            toast.show();
        }
    </script>
</body>
</html>