@using System.Security.Claims
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Твоя Карьера</title>

    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/careerflow.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var userRole = User.FindFirst(ClaimTypes.Role)?.Value;
        var isEmployer = userRole == "employer";
        var isAdmin = userRole == "admin";

        string searchVacanciesUrl = "/Vacancy/Search";
        string searchResumesUrl = "/Resume/Search";
    }

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
            <div class="container">
                <!-- Логотип -->
                <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
                    <img src="~/images/logotip.png" alt="Твоя Карьера" height="60" class="me-2" />
                    <span class="logo-text">Твоя Карьера</span>
                </a>

                <!-- Гамбургер (мобильные) -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Десктопная панель (скрыта на мобильных) -->
                <div class="d-none d-lg-flex align-items-center ms-auto gap-2">
                    <a href="@searchVacanciesUrl" class="btn search-mode-btn @(ViewContext.RouteData.Values["page"]?.ToString() == "/Vacancy/Search" ? "active" : "")">
                        <i class="fas fa-briefcase me-1"></i>Поиск вакансий
                    </a>
                    <a href="@searchResumesUrl" class="btn search-mode-btn @(ViewContext.RouteData.Values["page"]?.ToString() == "/Resume/Search" ? "active" : "")">
                        <i class="fas fa-address-card me-1"></i>Поиск резюме
                    </a>

                    @if (!isAuthenticated)
                    {
                        <a href="/Account/Login" class="btn btn-login">Войти</a>
                    }
                    else
                    {
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i> @User.FindFirst(ClaimTypes.GivenName)?.Value
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><a class="dropdown-item" href="@(isEmployer ? "/Account/EmployerDashboard" : isAdmin ? "/Admin/Index" : "/Account/JobSeekerDashboard")"><i class="fas fa-tachometer-alt me-2"></i>Личный кабинет</a></li>
                                <li><a class="dropdown-item" href="@(isEmployer ? "/Resume/Search" : "/Vacancy/Search")"><i class="fas fa-search me-2"></i>Поиск</a></li>
                                <li><a class="dropdown-item" href="/Account/Notifications"><i class="fas fa-bell me-2"></i>Уведомления</a></li>
                                <li><a class="dropdown-item" href="/Account/Chat"><i class="fas fa-comment me-2"></i>Чаты</a></li>
                                <li><a class="dropdown-item" href="/Account/Favorites"><i class="fas fa-star me-2"></i>Избранное</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/Account/Settings"><i class="fas fa-cog me-2"></i>Настройки</a></li>
                                @if (isAdmin)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Admin/Index"><i class="fas fa-shield-alt me-2"></i>Админ-панель</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-page="/Account/Logout">
                                        <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt me-2"></i>Выход</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>

                <!-- Мобильное меню (видно только на мобильных, скрыто на десктопе) -->
                <div class="collapse navbar-collapse d-lg-none" id="navbarNav">
                    <div class="py-3">
                        <a href="@searchVacanciesUrl" class="btn search-mode-btn w-100 mb-2 @(ViewContext.RouteData.Values["page"]?.ToString() == "/Vacancy/Search" ? "active" : "")">
                            <i class="fas fa-briefcase me-1"></i>Поиск вакансий
                        </a>
                        <a href="@searchResumesUrl" class="btn search-mode-btn w-100 mb-2 @(ViewContext.RouteData.Values["page"]?.ToString() == "/Resume/Search" ? "active" : "")">
                            <i class="fas fa-address-card me-1"></i>Поиск резюме
                        </a>
                        @if (!isAuthenticated)
                        {
                            <a href="/Account/Login" class="btn btn-login w-100 mb-2">Войти</a>
                        }
                        else
                        {
                            <a href="@(isEmployer ? "/Account/EmployerDashboard" : isAdmin ? "/Admin/Index" : "/Account/JobSeekerDashboard")" class="btn btn-outline-light w-100 mb-2">
                                <i class="fas fa-tachometer-alt me-1"></i>Личный кабинет
                            </a>
                            <a href="/Account/Notifications" class="btn btn-outline-light w-100 mb-2">
                                <i class="fas fa-bell me-1"></i>Уведомления
                            </a>
                            <a href="/Account/Chat" class="btn btn-outline-light w-100 mb-2">
                                <i class="fas fa-comment me-1"></i>Чаты
                            </a>
                            <a href="/Account/Favorites" class="btn btn-outline-light w-100 mb-2">
                                <i class="fas fa-star me-1"></i>Избранное
                            </a>
                            <a href="/Account/Settings" class="btn btn-outline-light w-100 mb-2">
                                <i class="fas fa-cog me-1"></i>Настройки
                            </a>
                            @if (isAdmin)
                            {
                                <a href="/Admin/Index" class="btn btn-outline-warning w-100 mb-2">
                                    <i class="fas fa-shield-alt me-1"></i>Админ-панель
                                </a>
                            }
                            <form method="post" asp-page="/Account/Logout">
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    <i class="fas fa-sign-out-alt me-1"></i>Выход
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Футер и остальное без изменений -->
    <footer class="footer py-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <a class="footer-brand d-flex align-items-center mb-3" href="/">
                        <img src="~/images/logotip.png" alt="Твоя Карьера" class="footer-logo me-2" />
                        <span class="footer-brand-text">Твоя Карьера</span>
                    </a>
                    <p class="text-white">Лучшая платформа для поиска работы и талантов</p>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Для студентов</h6>
                    <ul class="list-unstyled"></ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Для работодателей</h6>
                    <ul class="list-unstyled"></ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">О нас</h6>
                    <ul class="list-unstyled">
                        <li><a href="#">Контакты</a></li>
                        <li><a href="#">Помощь</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Соцсети</h6>
                    <div class="social-links">
                        <a href="https://vk.ru/club212655567" target="_blank" rel="noopener noreferrer"><i class="fab fa-vk"></i></a>
                        <a href="#"><i class="fab fa-telegram"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>
            <hr>
            <div class="text-center">
                <p class="mb-0">&copy; 2025 Твоя Карьера. Все права защищены.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/modern.js" asp-append-version="true"></script>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
        <div id="liveToast" class="toast" role="alert">
            <div class="toast-header">
                <strong class="me-auto text-primary">Твоя Карьера</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="toastMessage"></div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function showToast(message, type = 'success') {
        const toast = new bootstrap.Toast(document.getElementById('liveToast'));
        const toastBody = document.getElementById('toastMessage');
        toastBody.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle text-success' : 'exclamation-circle text-danger'} me-2"></i>${message}`;
        toast.show();
        }
    </script>
</body>
</html>