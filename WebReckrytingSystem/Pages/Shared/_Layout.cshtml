@using System.Security.Claims
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Твоя Карьера</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

    <!-- ТОЛЬКО НУЖНЫЕ СТИЛИ -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- НОВЫЙ ДИЗАЙН -->
    <link rel="stylesheet" href="~/css/careerflow.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var userRole = User.FindFirst(ClaimTypes.Role)?.Value;

        var isEmployer = userRole == "employer";
        var isAdmin = userRole == "admin";

        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
        var logoUrl = isEmployer ? "/Resume/Search" : "/Vacancy/Search";
        var profileUrl = isEmployer ? "/Account/EmployerDashboard" : isAdmin ? "/Admin/Index" : "/Account/JobSeekerDashboard";
        var defaultSearchMode = currentPage == "/Resume/Search"
            ? "resumes"
            : currentPage == "/Vacancy/Search"
                ? "vacancies"
                : isEmployer
                    ? "resumes"
                    : "vacancies";
        var searchUrl = isEmployer ? "/Resume/Search" : "/Vacancy/Search";
        var showNavbarSearch = currentPage == "/Vacancy/Search" || currentPage == "/Resume/Search";
    }

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" href="@logoUrl">
                    <img src="~/images/logotip.png" alt="Твоя Карьера" height="60" class="me-2" />
                    <span class="logo-text">Твоя Карьера</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    @if (!isAuthenticated)
                    {
                        <div class="ms-auto">
                            <a href="/Account/Login" class="btn btn-login">Войти</a>
                        </div>
                    }
                    else
                    {
                        <div class="navbar-auth-content w-100 d-lg-flex align-items-center justify-content-between gap-3">
                            @if (showNavbarSearch)
                            {
                                <div class="navbar-search-block">
                                    <div class="search-mode-switcher">
                                        <button type="button" class="search-mode-btn @(defaultSearchMode == "vacancies" ? "active" : "")" data-search-mode="vacancies">Вакансии</button>
                                        <button type="button" class="search-mode-btn @(defaultSearchMode == "resumes" ? "active" : "")" data-search-mode="resumes">Резюме</button>
                                    </div>
                                </div>
                            }

                            <ul class="navbar-nav align-items-lg-center ms-auto ">
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-user-circle me-1"></i> @User.FindFirst(ClaimTypes.GivenName)?.Value
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenu">
                                        <li><a class="dropdown-item" href="@profileUrl"><i class="fas fa-tachometer-alt me-2"></i>Личный кабинет</a></li>
                                        <li><a class="dropdown-item" href="@searchUrl"><i class="fas fa-search me-2"></i>Поиск</a></li>
                                        <li><a class="dropdown-item" href="/Account/Notifications"><i class="fas fa-bell me-2"></i>Уведомления</a></li>
                                        <li><a class="dropdown-item" href="/Account/Chat"><i class="fas fa-comment me-2"></i>Чаты</a></li>
                                        <li><a class="dropdown-item" href="/Account/Favorites"><i class="fas fa-star me-2"></i>Избранное</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="/Account/Settings"><i class="fas fa-cog me-2"></i>Настройки</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form method="post" asp-page="/Account/Logout">
                                                <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt me-2"></i>Выход</button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer py-5">
        <div class="container">
            <div class="row">
                <!-- ЛОГОТИП В ФУТЕРЕ -->
                <div class="col-md-4 mb-4">
                    <a class="footer-brand d-flex align-items-center mb-3" href="/">
                        <img src="~/images/logotip.png" alt="Твоя Карьера" class="footer-logo me-2" />
                        <span class="footer-brand-text">Твоя Карьера</span>
                    </a>
                    <p class="text-white">Лучшая платформа для поиска работы и талантов</p>
                </div>

                <!-- Остальные колонки -->
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Для студентов</h6>
                    <ul class="list-unstyled">
                        
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Для работодателей</h6>
                    <ul class="list-unstyled">
                       
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">О нас</h6>
                    <ul class="list-unstyled">
                        <li><a href="#">Контакты</a></li>
                        <li><a href="#">Помощь</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Соцсети</h6>
                    <div class="social-links">
                        <a href="https://vk.ru/club212655567" target="_blank" rel="noopener noreferrer"><i class="fab fa-vk"></i></a>
                        <a href="#"><i class="fab fa-telegram"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>
            <hr>
            <div class="text-center">
                <p class="mb-0">&copy; 2025 Твоя Карьера. Все права защищены.</p>
            </div>
        </div>
    </footer>

    <!-- ТОЛЬКО НУЖНЫЕ СКРИПТЫ -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/modern.js" asp-append-version="true"></script>

    <!-- TOAST CONTAINER -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
        <div id="liveToast" class="toast" role="alert">
            <div class="toast-header">
                <strong class="me-auto text-primary">Твоя Карьера</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="toastMessage"></div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const switchButtons = document.querySelectorAll('.search-mode-btn');
            if (!switchButtons.length) {
                return;
            }

            const applySearchMode = (mode) => {
                switchButtons.forEach((button) => {
                    button.classList.toggle('active', button.dataset.searchMode === mode);
                });
            };

            switchButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    const mode = button.dataset.searchMode;
                    applySearchMode(mode);

                    const targetPage = mode === 'resumes' ? '/Resume/Search' : '/Vacancy/Search';
                    if (window.location.pathname !== targetPage) {
                        window.location.href = targetPage;
                    }
                });
            });

            const activeButton = document.querySelector('.search-mode-btn.active');
            applySearchMode(activeButton?.dataset.searchMode ?? 'vacancies');
        });

        // Активация toasts
        function showToast(message, type = 'success') {
            const toast = new bootstrap.Toast(document.getElementById('liveToast'));
            const toastBody = document.getElementById('toastMessage');
            toastBody.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle text-success' : 'exclamation-circle text-danger'} me-2"></i>${message}`;
            toast.show();
        }
    </script>
</body>
</html>
