@using System.Security.Claims
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Recruiting System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/">
                    💼 RecruitingSystem
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Vacancy/Search">Поиск вакансий</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/@(User.IsInRole("employer") ? "Employer" : "JobSeeker")Dashboard">
                                    Личный кабинет
                                </a>
                            </li>
                            @if (User.IsInRole("admin"))  // <-- Добавьте это
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning" href="/Admin">
                                        <i class="fas fa-cog"></i> Админ-панель
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Register">Регистрация</a>
                            </li>
                        }
                    </ul>
                    <div class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <span class="nav-item nav-link text-light">
                                Привет, @User.FindFirst(ClaimTypes.GivenName)?.Value!
                            </span>
                            <form method="post" asp-page="/Account/Logout" class="nav-item">
                                <button type="submit" class="btn btn-outline-light btn-sm">Выйти</button>
                            </form>
                        }
                        else
                        {
                            <a href="/Account/Login" class="btn btn-outline-light btn-sm">Войти</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>RecruitingSystem</h5>
                    <p>Лучшая платформа для поиска работы и сотрудников</p>
                </div>
                <div class="col-md-3">
                    <h6>Соискателям</h6>
                    <ul class="list-unstyled">
                        <li><a asp-page="/Account/Register" asp-route-role="job_seeker" class="text-white-50">Найти работу</a></li>
                        <li><a href="#" class="text-white-50">Создать резюме</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6>Работодателям</h6>
                    <ul class="list-unstyled">
                        <li><a asp-page="/Account/Register" asp-route-role="employer" class="text-white-50">Разместить вакансию</a></li>
                        <li><a href="#" class="text-white-50">Найти сотрудников</a></li>
                    </ul>
                </div>
            </div>
            <hr class="my-3">
            <div class="text-center">
                <small>&copy; 2025 RecruitingSystem. Все права защищены.</small>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- toasts -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
        <div id="liveToast" class="toast" role="alert">
            <div class="toast-header">
                <strong class="me-auto text-primary">RecruitingSystem</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="toastMessage"></div>
        </div>
    </div>

    <!-- fonts + theme -->
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/modern.css" asp-append-version="true" />
    <script src="~/js/modern.js" asp-append-version="true"></script>
</body>
</html>