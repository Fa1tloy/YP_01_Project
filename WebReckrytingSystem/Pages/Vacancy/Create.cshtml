@page
@model WebReckrytingSystem.Pages.Vacancy.CreateModel
@{
    ViewData["Title"] = "Создать вакансию";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white rounded-top">
                    <h3 class="mb-0">Новая вакансия</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post" id="vacancyForm" novalidate>
                        <div asp-validation-summary="All" class="alert alert-danger rounded-pill"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="VacancyData.CompanyName" class="form-label fw-600">Компания *</label>
                                <select asp-for="VacancyData.CompanyName" class="form-select rounded-pill" required>
                                    <option value="">Выберите компанию</option>
                                    @foreach (var c in Model.Companies)
                                    {
                                        <option value="@c.Name">@c.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="VacancyData.CompanyName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="VacancyData.Title" class="form-label fw-600">Должность *</label>
                                <input asp-for="VacancyData.Title" class="form-control rounded-pill" placeholder="Senior .NET Developer" required />
                                <span asp-validation-for="VacancyData.Title" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="VacancyData.EmploymentType" class="form-label fw-600">Тип занятости *</label>
                                <select asp-for="VacancyData.EmploymentType" class="form-select rounded-pill" required>
                                    <option value="full">Полная занятость</option>
                                    <option value="part">Частичная</option>
                                    <option value="project">Проектная</option>
                                    <option value="internship">Стажировка</option>
                                    <option value="volunteer">Волонтерство</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="VacancyData.WorkSchedule" class="form-label fw-600">График *</label>
                                <select asp-for="VacancyData.WorkSchedule" class="form-select rounded-pill" required>
                                    <option value="full_day">Полный день</option>
                                    <option value="shifts">Сменный</option>
                                    <option value="flexible">Гибкий</option>
                                    <option value="remote">Удалёнка</option>
                                    <option value="shift_work">Вахта</option>
                                </select>
                            </div>

                            <!-- Зарплатный слайдер -->
                            <div class="col-12">
                                <label class="form-label fw-600">Диапазон зарплаты, ₽</label>
                                <div class="d-flex align-items-center gap-3">
                                    <input type="number" asp-for="VacancyData.SalaryFrom" class="form-control rounded-pill" placeholder="От" min="0" />
                                    <input type="range" class="form-range flex-grow-1" id="salaryRange" min="0" max="500000" step="10000" />
                                    <input type="number" asp-for="VacancyData.SalaryTo" class="form-control rounded-pill" placeholder="До" min="0" />
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="VacancyData.Description" class="form-label fw-600">Описание вакансии *</label>
                                <textarea asp-for="VacancyData.Description" class="form-control rounded-3" rows="4" placeholder="Обязанности, задачи, условия..." required></textarea>
                                <span asp-validation-for="VacancyData.Description" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="VacancyData.Requirements" class="form-label fw-600">Требования *</label>
                                <textarea asp-for="VacancyData.Requirements" class="form-control rounded-3" rows="4" placeholder="Опыт, навыки, образование..." required></textarea>
                                <span asp-validation-for="VacancyData.Requirements" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/Account/EmployerDashboard" class="btn btn-outline-secondary rounded-pill px-4">← Назад</a>
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5">
                                <i class="fas fa-plus me-2"></i>Создать вакансию
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // toast
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
                <text>showToast('@Html.Raw(Model.SuccessMessage)', 'success');</text>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
                <text>showToast('@Html.Raw(Model.ErrorMessage)', 'error');</text>
        }

        // range-slider
        const range = document.getElementById('salaryRange');
        const from = document.querySelector('input[name="VacancyData.SalaryFrom"]');
        const to = document.querySelector('input[name="VacancyData.SalaryTo"]');
        range.addEventListener('input', () => {
            const val = +range.value;
            from.value = val;
            to.value = Math.min(val + 50000, 500000);
        });
    </script>
}