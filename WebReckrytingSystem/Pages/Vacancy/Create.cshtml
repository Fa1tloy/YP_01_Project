@page
@model WebReckrytingSystem.Pages.Vacancy.CreateModel
@{
    ViewData["Title"] = "Создание вакансии";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Создание вакансии</h4>
                </div>
                <div class="card-body">
                    @if (!Model.Companies.Any())
                    {
                        <div class="alert alert-info">
                            <h5>У вас нет компаний</h5>
                            <p>Для создания вакансии сначала нужно создать компанию.</p>
                            <a href="/Company/Create" class="btn btn-primary">Создать компанию</a>
                        </div>
                    }
                    else
                    {
                        <form method="post">
                            <!-- Остальная форма создания вакансии -->
                            <div class="mb-3">
                                <label asp-for="VacancyData.CompanyName" class="form-label">Компания *</label>
                                <select asp-for="VacancyData.CompanyName" class="form-control" required>
                                    <option value="">Выберите компанию</option>
                                    @foreach (var company in Model.Companies)
                                    {
                                        <option value="@company.Name">@company.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="VacancyData.CompanyName" class="text-danger"></span>
                                <small class="form-text text-muted">
                                    Нет подходящей компании? <a href="/Company/Create">Создать новую</a>
                                </small>
                            </div>

                            <!-- Остальные поля формы -->
                            <!-- ... -->

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success">Создать вакансию</button>
                                <a href="/Account/EmployerDashboard" class="btn btn-secondary">Отмена</a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}