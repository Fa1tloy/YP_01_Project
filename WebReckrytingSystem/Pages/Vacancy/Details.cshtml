@page "{companyName}/{title}"
@using System.Security.Claims
@model WebReckrytingSystem.Pages.Vacancy.DetailsModel
@{
    ViewData["Title"] = Model.Vacancy is null ? "Вакансия" : Model.Vacancy.Title;
}

<div class="container py-5" style="padding-top: 104px !important;">
    <!-- КНОПКА НАЗАД С ОТСТУПОМ -->
    <div class="mb-4" style="margin-top: 20px;">
        <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4" id="backButton">
            <i class="fas fa-arrow-left me-2"></i>Назад
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i>@Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Vacancy is null)
    {
        <div class="alert alert-warning text-center py-4">
            <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
            <h4>Вакансия не найдена</h4>
            <p>Возможно, она была удалена или у вас нет прав для просмотра</p>
            <a href="/Vacancy/Search" class="btn btn-primary mt-3">
                <i class="fas fa-search me-2"></i>Поиск вакансий
            </a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-lg">
            <!-- ШАПКА С ЛОГОТИПОМ -->
            <div class="card-header bg-white border-0 pt-4 px-4">
                <div class="d-flex align-items-center gap-3">
                    <img src="@(string.IsNullOrWhiteSpace(Model.Vacancy.Author?.AvatarUrl) ? "/images/rabotodatel.jpg" : Model.Vacancy.Author.AvatarUrl)"
                         alt="Аватар администратора вакансии @Model.Vacancy.CompanyName"
                         class="rounded-circle border"
                         style="width: 80px; height: 80px; object-fit: cover; background-color: #f8f9fa;">
                    <div>
                        <h1 class="h3 mb-1 fw-bold">@Model.Vacancy.Title</h1>
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-primary">@Model.Vacancy.CompanyName</span>
                            @if (Model.Vacancy.Company?.Verified == true)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">
                                    <i class="fas fa-check-circle me-1"></i>Проверенная компания
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <!-- СЕТКА С ИНФОРМАЦИЕЙ -->
                <div class="row g-4">
                    <!-- ЛЕВАЯ КОЛОНКА - ОСНОВНАЯ ИНФОРМАЦИЯ -->
                    <div class="col-lg-8">
                        <!-- ЗАРПЛАТА -->
                        <div class="bg-light rounded-4 p-4 mb-4">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-muted small">Зарплата</span>
                                    <h2 class="text-success fw-bold mb-0">
                                        @if (Model.Vacancy.SalaryFrom.HasValue && Model.Vacancy.SalaryTo.HasValue)
                                        {
                                            @:@Model.Vacancy.SalaryFrom.Value.ToString("N0") – @Model.Vacancy.SalaryTo.Value.ToString("N0") ₽
                                        }
                                        else if (Model.Vacancy.SalaryFrom.HasValue)
                                        {
                                            @:от @Model.Vacancy.SalaryFrom.Value.ToString("N0") ₽
                                        }
                                        else if (Model.Vacancy.SalaryTo.HasValue)
                                        {
                                            @:до @Model.Vacancy.SalaryTo.Value.ToString("N0") ₽
                                        }
                                        else
                                        {
                                            <span class="text-secondary">Зарплата не указана</span>
                                        }
                                    </h2>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-light text-dark rounded-pill px-3 py-2">
                                        @(Model.Vacancy.SalaryPeriod switch
                                        {
                                            "month" => "в месяц",
                                            "hour" => "в час",
                                            "shift" => "за смену",
                                            "service" => "за услугу",
                                            "rotation" => "за вахту",
                                            _ => Model.Vacancy.SalaryPeriod
                                        })
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- ОПИСАНИЕ -->
                        <div class="mb-5">
                            <h5 class="fw-bold mb-3">
                                <i class="fas fa-align-left text-primary me-2"></i>Описание вакансии
                            </h5>
                            <div class="text-secondary" style="white-space: pre-line;">@Model.Vacancy.Description</div>
                        </div>

                        <!-- ТРЕБОВАНИЯ -->
                        <div class="mb-5">
                            <h5 class="fw-bold mb-3">
                                <i class="fas fa-clipboard-check text-primary me-2"></i>Требования к кандидату
                            </h5>
                            <div class="text-secondary" style="white-space: pre-line;">@Model.Vacancy.Requirements</div>
                        </div>
                    </div>

                    <!-- ПРАВАЯ КОЛОНКА - ДЕТАЛИ -->
                    <div class="col-lg-4">
                        <div class="card border-0 bg-light rounded-4 sticky-top" style="top: 100px;">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-4">
                                    <i class="fas fa-info-circle me-2 text-primary"></i>Детали вакансии
                                </h5>

                                <div class="vstack gap-3">
                                    <!-- Тип занятости -->
                                    <div class="d-flex align-items-center">
                                        <div class="bg-white p-2 rounded-3 me-3" style="width: 40px; height: 40px;">
                                            <i class="fas fa-clock text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="small text-muted">Тип занятости</div>
                                            <div class="fw-semibold">
                                                @(Model.Vacancy.EmploymentType switch
                                                {
                                                    "full" => "Полная занятость",
                                                    "part" => "Частичная занятость",
                                                    "project" => "Проектная работа",
                                                    "internship" => "Стажировка",
                                                    "volunteer" => "Волонтёрство",
                                                    _ => Model.Vacancy.EmploymentType
                                                })
                                            </div>
                                        </div>
                                    </div>

                                    <!-- График работы -->
                                    <div class="d-flex align-items-center">
                                        <div class="bg-white p-2 rounded-3 me-3" style="width: 40px; height: 40px;">
                                            <i class="fas fa-calendar-alt text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="small text-muted">График работы</div>
                                            <div class="fw-semibold">
                                                @(Model.Vacancy.WorkSchedule switch
                                                {
                                                    "full_day" => "Полный день",
                                                    "shifts" => "Сменный график",
                                                    "flexible" => "Гибкий график",
                                                    "remote" => "Удалённая работа",
                                                    "shift_work" => "Вахтовый метод",
                                                    _ => Model.Vacancy.WorkSchedule
                                                })
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Часы в день -->
                                    @if (Model.Vacancy.WorkHoursPerDay.HasValue)
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="bg-white p-2 rounded-3 me-3" style="width: 40px; height: 40px;">
                                                <i class="fas fa-hourglass-half text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="small text-muted">Рабочих часов в день</div>
                                                <div class="fw-semibold">@Model.Vacancy.WorkHoursPerDay ч</div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Формат работы -->
                                    @if (!string.IsNullOrWhiteSpace(Model.Vacancy.WorkFormat))
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="bg-white p-2 rounded-3 me-3" style="width: 40px; height: 40px;">
                                                <i class="fas fa-laptop-house text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="small text-muted">Формат работы</div>
                                                <div class="fw-semibold">
                                                    @(Model.Vacancy.WorkFormat switch
                                                    {
                                                        "office" => "В офисе",
                                                        "remote" => "Удалённо",
                                                        "travel" => "Разъездной",
                                                        "hybrid" => "Гибрид",
                                                        _ => Model.Vacancy.WorkFormat
                                                    })
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Регион -->
                                    @if (!string.IsNullOrWhiteSpace(Model.Vacancy.Region))
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="bg-white p-2 rounded-3 me-3" style="width: 40px; height: 40px;">
                                                <i class="fas fa-map-marker-alt text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="small text-muted">Регион</div>
                                                <div class="fw-semibold">@Model.Vacancy.Region</div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Специальность -->
                                    @if (!string.IsNullOrWhiteSpace(Model.Vacancy.Specialty))
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="bg-white p-2 rounded-3 me-3" style="width: 40px; height: 40px;">
                                                <i class="fas fa-graduation-cap text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="small text-muted">Специальность</div>
                                                <div class="fw-semibold">@Model.Vacancy.Specialty</div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Частота выплат -->
                                    @if (!string.IsNullOrWhiteSpace(Model.Vacancy.PaymentFrequency))
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="bg-white p-2 rounded-3 me-3" style="width: 40px; height: 40px;">
                                                <i class="fas fa-credit-card text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="small text-muted">Частота выплат</div>
                                                <div class="fw-semibold">
                                                    @(Model.Vacancy.PaymentFrequency switch
                                                    {
                                                        "weekly" => "Еженедельно",
                                                        "biweekly" => "Раз в 2 недели",
                                                        "monthly" => "Ежемесячно",
                                                        "after_shift" => "После смены",
                                                        "contract" => "По договоренности",
                                                        _ => Model.Vacancy.PaymentFrequency
                                                    })
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <hr class="my-4">

                                <!-- КОНТАКТЫ -->
                                <h5 class="fw-bold mb-3">
                                    <i class="fas fa-address-card me-2 text-primary"></i>Контакты администратора
                                </h5>

                                <div class="vstack gap-2">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-envelope text-primary me-3" style="width: 20px;"></i>
                                        <a href="mailto:@Model.Vacancy.AuthorEmail" class="text-decoration-none">@Model.Vacancy.AuthorEmail</a>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(Model.Vacancy.Company?.Website))
                                    {
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-globe text-primary me-3" style="width: 20px;"></i>
                                            <a href="@Model.Vacancy.Company.Website" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                                @Model.Vacancy.Company.Website
                                            </a>
                                        </div>
                                    }
                                </div>

                                <!-- ДЕЙСТВИЯ -->
                                <hr class="my-4">

                                <div class="vstack gap-2">
                                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("job_seeker"))
                                    {
                                        <!-- Кнопка отклика -->
                                        <form method="post" asp-page-handler="Apply" class="w-100">
                                            <input type="hidden" name="companyName" value="@Model.Vacancy.CompanyName" />
                                            <input type="hidden" name="title" value="@Model.Vacancy.Title" />
                                            <button type="submit" class="btn btn-success w-100 py-3 fw-semibold">
                                                <i class="fas fa-paper-plane me-2"></i>Откликнуться администратору
                                            </button>
                                        </form>

                                        <!-- Кнопка избранного -->
                                        <form method="post" asp-page-handler="SaveVacancy" class="w-100">
                                            <input type="hidden" name="companyName" value="@Model.Vacancy.CompanyName" />
                                            <input type="hidden" name="title" value="@Model.Vacancy.Title" />
                                            <button type="submit" class="btn @(Model.IsSavedByCurrentStudent ? "btn-warning" : "btn-outline-warning") w-100 py-3">
                                                <i class="fas fa-star me-2"></i>
                                                @(Model.IsSavedByCurrentStudent ? "Удалить из избранного" : "Сохранить в избранное")
                                            </button>
                                        </form>

                                        <!-- Кнопка чата (если уже есть диалог) -->
                                        @if (Model.HasExistingChat)
                                        {
                                            <a href="/Account/Chat?peer=@Model.Vacancy.AuthorEmail&companyName=@Model.Vacancy.CompanyName&title=@Model.Vacancy.Title"
                                               class="btn btn-outline-primary w-100 py-3 mt-2">
                                                <i class="fas fa-comment me-2"></i>Перейти в чат
                                            </a>
                                        }
                                    }
                                    else if (!User.Identity?.IsAuthenticated == true)
                                    {
                                        <a asp-page="/Account/Login" asp-route-returnUrl="@Model.Request.Path" class="btn btn-primary w-100 py-3 fw-semibold">
                                            <i class="fas fa-sign-in-alt me-2"></i>Войдите, чтобы откликнуться
                                        </a>
                                    }
                                    else if (User.IsInRole("employer") && User.FindFirstValue(ClaimTypes.Email) == Model.Vacancy.AuthorEmail)
                                    {
                                        <!-- Кнопка редактирования для автора вакансии -->
                                        <a asp-page="/Vacancy/Edit"
                                           asp-route-companyName="@Model.Vacancy.CompanyName"
                                           asp-route-title="@Model.Vacancy.Title"
                                           class="btn btn-outline-primary w-100 py-3">
                                            <i class="fas fa-edit me-2"></i>Редактировать вакансию
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ИНФОРМАЦИЯ О КОМПАНИИ -->
                @if (Model.Vacancy.Company != null)
                {
                    <div class="mt-5">
                        <h5 class="fw-bold mb-3">
                            <i class="fas fa-building text-primary me-2"></i>О компании @Model.Vacancy.CompanyName
                        </h5>
                        <div class="card border-0 bg-light">
                            <div class="card-body">
                                @if (!string.IsNullOrWhiteSpace(Model.Vacancy.Company.Description))
                                {
                                    <p class="text-secondary">@Model.Vacancy.Company.Description</p>
                                }
                                else
                                {
                                    <p class="text-secondary fst-italic">Нет описания компании</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Автоматическое скрытие уведомлений через 5 секунд
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert-info');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);

        // Альтернативная кнопка назад, если history.back() не сработает
        document.getElementById('backButton')?.addEventListener('click', function (e) {
            if (document.referrer === '') {
                e.preventDefault();
                window.location.href = '/Vacancy/Search';
            }
        });
    </script>
}
