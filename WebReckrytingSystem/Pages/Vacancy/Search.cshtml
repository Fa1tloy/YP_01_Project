@page
@model WebReckrytingSystem.Pages.Vacancy.SearchModel
@{
    ViewData["Title"] = "Поиск вакансий";
}

<div class="container-fluid px-0">
    <section class="search-hero py-5 bg-primary text-white text-center">
        <div class="container">
            <h1 class="display-5 fw-bold mb-3"><i class="fas fa-search me-2"></i>Поиск вакансий</h1>
            <p class="lead opacity-75 mb-0">Подберите подходящую вакансию по фильтрам и ключевым словам</p>
        </div>
    </section>

    <div class="container my-4">
        <form method="get" id="searchForm" class="mb-4">
            <div class="row g-2 align-items-end">
                <div class="col-lg-10">
                    <label asp-for="SearchData.Keywords" class="form-label fw-semibold">Строка поиска</label>
                    <input asp-for="SearchData.Keywords" class="form-control" placeholder="Например: C#, стажер, тестировщик" />
                </div>
                <div class="col-lg-2 d-grid">
                    <button type="submit" class="btn btn-primary fw-semibold">Найти</button>
                </div>
            </div>

            <div class="row g-4 mt-1">
                <div class="col-lg-4 col-xl-3">
                    <div class="card shadow-sm border-0 sticky-top" style="top: 96px;">
                        <div class="card-header bg-white fw-bold">Фильтры</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Регион</label>
                                <input asp-for="SearchData.Region" class="form-control" placeholder="Москва, СПб" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="SearchData.WorkSchedule" class="form-label">График работы</label>
                                <select asp-for="SearchData.WorkSchedule" class="form-select">
                                    <option value="">Любой</option>
                                    <option value="full_day">Полный день</option>
                                    <option value="shifts">Сменный</option>
                                    <option value="flexible">Гибкий</option>
                                    <option value="remote">Удаленная</option>
                                    <option value="shift_work">Вахтовый</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Рабочие часы в день</label>
                                <input asp-for="SearchData.WorkHoursPerDay" type="number" class="form-control" min="1" max="24" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Формат работы</label>
                                <select asp-for="SearchData.WorkFormat" class="form-select">
                                    <option value="">Любой</option>
                                    <option value="office">В офисе</option>
                                    <option value="remote">Удалённо</option>
                                    <option value="travel">Разъездной</option>
                                    <option value="hybrid">Гибрид</option>
                                </select>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label asp-for="SearchData.SalaryFrom" class="form-label">Доход от</label>
                                    <input asp-for="SearchData.SalaryFrom" type="number" class="form-control" min="0" />
                                </div>
                                <div class="col-6">
                                    <label asp-for="SearchData.SalaryTo" class="form-label">Доход до</label>
                                    <input asp-for="SearchData.SalaryTo" type="number" class="form-control" min="0" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Период дохода</label>
                                <select asp-for="SearchData.SalaryPeriod" class="form-select">
                                    <option value="">Любой</option>
                                    <option value="месяц">месяц</option>
                                    <option value="час">час</option>
                                    <option value="смена">смена</option>
                                    <option value="услуга">услуга</option>
                                    <option value="вахта">вахта</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Частота выплат</label>
                                <select asp-for="SearchData.PaymentFrequency" class="form-select">
                                    <option value="">Любая</option>
                                    <option value="еженедельно">еженедельно</option>
                                    <option value="2 раза в месяц">2 раза в месяц</option>
                                    <option value="ежемесячно">ежемесячно</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="SearchData.CompanyName" class="form-label">Название компании</label>
                                <input asp-for="SearchData.CompanyName" class="form-control" placeholder="Начните вводить название" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Специальность</label>
                                <select asp-for="SearchData.Specialty" class="form-select">
                                    <option value="">Любая</option>
                                    @foreach (var specialty in WebReckrytingSystem.Models.SpecialtyCatalog.All)
                                    {
                                        <option value="@specialty">@specialty</option>
                                    }
                                </select>
                            </div>

                            <input type="hidden" asp-for="SearchData.Page" value="1" />
                            <input type="hidden" asp-for="SearchData.PageSize" value="10" />

                            <button type="submit" class="btn btn-primary w-100">Найти</button>
                            <a asp-page="/Vacancy/Search" class="btn btn-outline-secondary w-100 mt-2">Сбросить</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8 col-xl-9">
                    <h2 class="h5 mb-3">Карточки вакансий (@Model.SearchResult.TotalCount)</h2>

                    @if (Model.SearchResult.Items.Any())
                    {
                        <div class="row g-3">
                            @foreach (var vacancy in Model.SearchResult.Items)
                            {
                                <div class="col-xl-6">
                                    <div class="card h-100 shadow-sm border-0">
                                        <div class="card-body d-flex flex-column">
                                            <div class="d-flex align-items-start gap-3 mb-2">
                                                <img src="@(string.IsNullOrWhiteSpace(vacancy.Company?.LogoUrl) ? "/images/rabotodatel.jpg" : vacancy.Company.LogoUrl)"
                                                     alt="Логотип @vacancy.CompanyName"
                                                     style="width:48px;height:48px;object-fit:cover;border-radius:10px;" />
                                                <div>
                                                    <h3 class="h6 mb-1">@vacancy.Title</h3>
                                                    <div class="text-muted small">@vacancy.CompanyName</div>
                                                </div>
                                            </div>

                                            <div class="fw-semibold text-success mb-2">
                                                @if (vacancy.SalaryFrom.HasValue && vacancy.SalaryTo.HasValue)
                                                {
                                                    @:@vacancy.SalaryFrom.Value.ToString("N0") - @vacancy.SalaryTo.Value.ToString("N0") ₽
                                                }
                                                else if (vacancy.SalaryFrom.HasValue)
                                                {
                                                    @:от @vacancy.SalaryFrom.Value.ToString("N0") ₽
                                                }
                                                else
                                                {
                                                    @:З/п не указана
                                                }
                                            </div>

                                            <p class="text-muted small flex-grow-1">@Truncate(vacancy.Description, 170)</p>

                                            <div class="d-flex gap-2 mt-auto">
                                                <a class="btn btn-outline-primary flex-fill"
                                                   asp-page="/Vacancy/Details"
                                                   asp-route-companyName="@vacancy.CompanyName"
                                                   asp-route-title="@vacancy.Title">Открыть</a>
                                                <a class="btn btn-primary flex-fill"
                                                   asp-page="/Vacancy/Details"
                                                   asp-route-companyName="@vacancy.CompanyName"
                                                   asp-route-title="@vacancy.Title">Откликнуться</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border">Вакансии не найдены.</div>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('searchForm');
            if (!form) {
                return;
            }

            const autoSubmitSelectors = [
                'input[name="SearchData.Keywords"]',
                'input[name="SearchData.Region"]',
                'input[name="SearchData.WorkHoursPerDay"]',
                'input[name="SearchData.SalaryFrom"]',
                'input[name="SearchData.SalaryTo"]',
                'input[name="SearchData.CompanyName"]',
                'select[name="SearchData.WorkSchedule"]',
                'select[name="SearchData.WorkFormat"]',
                'select[name="SearchData.SalaryPeriod"]',
                'select[name="SearchData.PaymentFrequency"]',
                'select[name="SearchData.Specialty"]'
            ];

            const controls = form.querySelectorAll(autoSubmitSelectors.join(','));
            const pageInput = form.querySelector('input[name="SearchData.Page"]');
            let debounceTimer;

            const submitSearch = () => {
                if (pageInput) {
                    pageInput.value = '1';
                }

                form.requestSubmit();
            };

            const debouncedSubmit = () => {
                window.clearTimeout(debounceTimer);
                debounceTimer = window.setTimeout(submitSearch, 400);
            };

            controls.forEach(control => {
                if (control.tagName === 'SELECT') {
                    control.addEventListener('change', submitSearch);
                    return;
                }

                if (control.type === 'number' || control.type === 'text') {
                    control.addEventListener('input', debouncedSubmit);
                    control.addEventListener('change', submitSearch);
                }
            });
        })();
    </script>
}

@functions {
    string Truncate(string text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        return text.Length <= maxLength ? text : text[..maxLength] + "...";
    }
}
