@page
@model WebReckrytingSystem.Pages.Admin.VacanciesModel
@{
    ViewData["Title"] = "Вакансии";
    Layout = "_AdminLayout";
}

<div class="card shadow-sm">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-briefcase me-2"></i>Управление вакансиями</h5>
        <div class="d-flex align-items-center gap-2">
            <a asp-page="/Vacancy/Create" class="btn btn-light btn-sm text-info fw-bold">
                <i class="fas fa-plus me-1"></i>Создать вакансию
            </a>
            <span class="badge bg-light text-info">@Model.Vacancies.TotalCount</span>
        </div>
    </div>
    <div class="card-body">
        <!-- Фильтры -->
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <input asp-for="SearchTitle" class="form-control" placeholder="Название вакансии" />
            </div>
            <div class="col-md-3">
                <input asp-for="SearchCompany" class="form-control" placeholder="Компания" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-info w-100 text-white">
                    <i class="fas fa-search"></i> Найти
                </button>
            </div>
        </form>

        <!-- Таблица -->
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Должность</th>
                        <th>Компания</th>
                        <th>Зарплата</th>
                        <th>Тип занятости</th>
                        <th>Автор</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vacancy in Model.Vacancies.Items)
                    {
                        <tr>
                            <td><strong>@vacancy.Title</strong></td>
                            <td>@vacancy.CompanyName</td>
                            <td>
                                @if (vacancy.SalaryFrom.HasValue)
                                {
                                    <text>от @vacancy.SalaryFrom.Value.ToString("N0") ₽</text>
                                }
                                else
                                {
                                    <span class="text-muted">Договорная</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary">@GetEmploymentTypeDisplay(vacancy.EmploymentType)</span>
                            </td>
                            <td>@vacancy.AuthorEmail</td>
                            <td>
                                <a asp-page="/Admin/VacancyDetails" asp-route-companyName="@vacancy.CompanyName" asp-route-title="@vacancy.Title" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-page="/Admin/VacancyEdit" asp-route-companyName="@vacancy.CompanyName" asp-route-title="@vacancy.Title" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Удалить вакансию?')">
                                    <input type="hidden" name="companyName" value="@vacancy.CompanyName" />
                                    <input type="hidden" name="title" value="@vacancy.Title" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Пагинация -->
        @if (Model.Vacancies.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @if (Model.Vacancies.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-route-page="@(Model.Vacancies.Page - 1)">Назад</a>
                        </li>
                    }
                    @for (int i = 1; i <= Model.Vacancies.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Vacancies.Page ? "active" : "")">
                            <a class="page-link" asp-route-page="@i">@i</a>
                        </li>
                    }
                    @if (Model.Vacancies.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-route-page="@(Model.Vacancies.Page + 1)">Вперед</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

@functions {
    string GetEmploymentTypeDisplay(string employmentType)
    {
        return employmentType switch
        {
            "full" => "Полная",
            "part" => "Частичная",
            "project" => "Проектная",
            "internship" => "Стажировка",
            "volunteer" => "Волонтерство",
            _ => employmentType
        };
    }
}