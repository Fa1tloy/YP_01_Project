@page
@model WebReckrytingSystem.Pages.Admin.CompanyDetailsModel
@{
    ViewData["Title"] = "Компания";
    Layout = "_AdminLayout";
}

@if (Model.Company == null)
{
    <div class="alert alert-warning">Компания не найдена.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@Model.Company.Name</h5>
            <span class="badge bg-@(Model.Company.Verified ? "success" : "warning")">@(Model.Company.Verified ? "Проверена" : "Ожидает проверки")</span>
        </div>
        <div class="card-body">
            <p><strong>Сайт:</strong> @Model.Company.Website</p>
            <p><strong>Описание:</strong><br/>@Model.Company.Description</p>
            <p><strong>Количество вакансий:</strong> @Model.Company.Vacancies.Count</p>
            <a asp-page="/Admin/Companies/Companies" class="btn btn-outline-secondary">Назад</a>
        </div>
    </div>
}
