@page
@model WebReckrytingSystem.Pages.Admin.CompanyDetailsModel
@{
    ViewData["Title"] = "Компания";
    Layout = "_AdminLayout";
}

@if (Model.Company == null)
{
    <div class="alert alert-warning">Компания не найдена.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@Model.Company.Name</h5>
            <span class="badge bg-@(Model.Company.Verified ? "success" : "warning")">
                @(Model.Company.Verified ? "Проверена" : "Ожидает проверки")
            </span>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success">@successMessage</div>
            }
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="row">
                <div class="col-md-4 text-center mb-4">
                    <h6 class="fw-bold mb-3">Логотип компании</h6>
                    <img src="@(Model.Company.LogoUrl ?? "/images/rabotodatel.jpg")"
                         alt="Логотип @Model.Company.Name"
                         class="img-thumbnail rounded-3"
                         style="max-width: 200px; max-height: 200px; object-fit: contain;" />

                    <form method="post" enctype="multipart/form-data" asp-page-handler="UploadLogo" class="mt-3">
                        <input type="hidden" name="name" value="@Model.Company.Name" />
                        <div class="input-group">
                            <input asp-for="LogoFile" type="file" accept="image/*" class="form-control form-control-sm" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">Загрузить</button>
                        </div>
                    </form>
                </div>

                <div class="col-md-8">
                    <p><strong>Сайт:</strong> @(Model.Company.Website ?? "-")</p>
                    <p><strong>Описание:</strong><br />@(Model.Company.Description ?? "-")</p>
                    <p><strong>Количество вакансий:</strong> @Model.Company.Vacancies.Count</p>
                </div>
            </div>
            <a asp-page="/Admin/Companies/Edit" asp-route-name="@Model.Company.Name"
                   class="btn btn-warning me-2">
                <i class="fas fa-edit me-1"></i>Редактировать
            </a>

            <a asp-page="/Admin/Companies/Companies" class="btn btn-outline-secondary">Назад</a>
        </div>
    </div>
}