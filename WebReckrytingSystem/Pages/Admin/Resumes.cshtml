@page
@using System.Text.Json
@model WebReckrytingSystem.Pages.Admin.ResumesModel
@{
    ViewData["Title"] = "Резюме";
    Layout = "_AdminLayout";
}

<div class="card shadow-sm">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i>Управление резюме</h5>
        <span class="badge bg-light text-success">@Model.Resumes.TotalCount</span>
    </div>
    <div class="card-body">
        <!-- Фильтры -->
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <input asp-for="SearchEmail" class="form-control" placeholder="Email соискателя" />
            </div>
            <div class="col-md-3">
                <input asp-for="SearchPosition" class="form-control" placeholder="Должность" />
            </div>
            <div class="col-md-2">
                <select asp-for="FilterStatus" class="form-select">
                    <option value="">Все статусы</option>
                    <option value="published">Опубликовано</option>
                    <option value="draft">Черновик</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100">
                    <i class="fas fa-search"></i> Найти
                </button>
            </div>
        </form>

        <!-- Таблица -->
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Email</th>
                        <th>Должность</th>
                        <th>Зарплата</th>
                        <th>Навыки</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var resume in Model.Resumes.Items)
                    {
                        <tr>
                            <td>
                                <small class="text-muted">@resume.UserEmail</small>
                            </td>
                            <td>
                                <strong>@resume.DesiredPosition</strong>
                            </td>
                            <td>
                                @if (resume.SalaryExpectations.HasValue)
                                {
                                    <span class="text-success">@resume.SalaryExpectations.Value.ToString("N0") ₽</span>
                                }
                                else
                                {
                                    <span class="text-muted">Не указана</span>
                                }
                            </td>
                            <td>
                                @{
                                    var skills = !string.IsNullOrEmpty(resume.Skills)
                                    ? string.Join(", ", resume.Skills.Split(',').Take(3))
                                    : "-";
                                }
                                <small class="text-muted">@skills</small>
                            </td>
                            <td>
                                <span class="badge bg-@(resume.IsPublished ? "success" : "secondary") rounded-pill">
                                    <i class="fas fa-@(resume.IsPublished ? "eye" : "eye-slash") me-1"></i>
                                    @(resume.IsPublished ? "Опубликовано" : "Черновик")
                                </span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="/Admin/ResumeDetails" asp-route-email="@resume.UserEmail" class="btn btn-outline-info" title="Просмотр">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-page="/Admin/ResumeEdit" asp-route-email="@resume.UserEmail" class="btn btn-outline-warning" title="Редактировать">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" asp-page-handler="TogglePublish" class="d-inline">
                                        <input type="hidden" name="email" value="@resume.UserEmail" />
                                        <button type="submit" class="btn btn-outline-@(resume.IsPublished ? "secondary" : "success")"
                                                title="@(resume.IsPublished ? "Снять с публикации" : "Опубликовать")">
                                            <i class="fas fa-@(resume.IsPublished ? "toggle-off" : "toggle-on")"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Удалить резюме? Это действие необратимо.')">
                                        <input type="hidden" name="email" value="@resume.UserEmail" />
                                        <button type="submit" class="btn btn-outline-danger" title="Удалить">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Пагинация -->
        @if (Model.Resumes.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @if (Model.Resumes.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-route-page="@(Model.Resumes.Page - 1)">Назад</a>
                        </li>
                    }
                    @for (int i = 1; i <= Model.Resumes.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Resumes.Page ? "active" : "")">
                            <a class="page-link" asp-route-page="@i">@i</a>
                        </li>
                    }
                    @if (Model.Resumes.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-route-page="@(Model.Resumes.Page + 1)">Вперед</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>