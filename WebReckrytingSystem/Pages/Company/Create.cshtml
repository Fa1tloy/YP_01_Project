@page
@model WebReckrytingSystem.Pages.Company.CreateModel
@{
    ViewData["Title"] = "Создание компании";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Создание компании</h4>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success">
                            @Model.SuccessMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @Model.ErrorMessage
                        </div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="CompanyData.Name" class="form-label">Название компании *</label>
                            <input asp-for="CompanyData.Name" class="form-control" placeholder="Введите название компании" />
                            <span asp-validation-for="CompanyData.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CompanyData.Description" class="form-label">Описание компании</label>
                            <textarea asp-for="CompanyData.Description" class="form-control" rows="3" placeholder="Опишите деятельность компании"></textarea>
                            <span asp-validation-for="CompanyData.Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CompanyData.Website" class="form-label">Веб-сайт</label>
                            <input asp-for="CompanyData.Website" class="form-control" placeholder="https://example.com" />
                            <span asp-validation-for="CompanyData.Website" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">Создать компанию</button>
                            <a href="/Vacancy/Create" class="btn btn-secondary">Назад к созданию вакансии</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}