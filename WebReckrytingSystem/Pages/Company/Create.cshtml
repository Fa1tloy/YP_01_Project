@page
@model WebReckrytingSystem.Pages.Company.CreateModel
@{
    ViewData["Title"] = "Создать компанию";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white rounded-top">
                    <h3 class="mb-0">Новая компания</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post" id="companyForm" enctype="multipart/form-data" novalidate>
                        <div asp-validation-summary="All" class="alert alert-danger rounded-pill"></div>

                        <div class="mb-3">
                            <label asp-for="CompanyData.Name" class="form-label fw-600">Название *</label>
                            <input asp-for="CompanyData.Name" class="form-control rounded-pill" placeholder="ООО Ромашка" />
                            <span asp-validation-for="CompanyData.Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CompanyData.Description" class="form-label fw-600">Описание</label>
                            <textarea asp-for="CompanyData.Description" class="form-control rounded-3" rows="3" placeholder="Краткое описание деятельности"></textarea>
                            <span asp-validation-for="CompanyData.Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-600">Логотип</label>
                            <div class="drop-area rounded-3 text-center p-4">
                                <i class="fas fa-cloud-upload-alt fa-2x text-primary mb-2"></i>
                                <p class="mb-0">Перетащите изображение или <strong>кликните</strong></p>
                                <input type="file" id="logoFile" accept="image/*" class="d-none" />
                            </div>
                            <img id="logoPreview" class="img-fluid rounded mt-3 d-none" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill px-5">
                                <i class="fas fa-plus me-2"></i>Создать компанию
                            </button>
                            <a href="/Vacancy/Create" class="btn btn-outline-secondary rounded-pill px-4">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // drag-n-drop логотип
        const dropArea = document.querySelector('.drop-area');
        const fileInp = document.getElementById('logoFile');
        const preview = document.getElementById('logoPreview');

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(evt => dropArea.addEventListener(evt, e => e.preventDefault()));
        ['dragenter', 'dragover'].forEach(evt => dropArea.addEventListener(evt, () => dropArea.classList.add('border-primary')));
        ['dragleave', 'drop'].forEach(evt => dropArea.addEventListener(evt, () => dropArea.classList.remove('border-primary')));

        dropArea.addEventListener('drop', e => {
            const files = e.dataTransfer.files;
            if (files.length) handleFile(files[0]);
        });
        dropArea.addEventListener('click', () => fileInp.click());
        fileInp.addEventListener('change', e => handleFile(e.target.files[0]));

        function handleFile(file) {
            if (!file.type.startsWith('image/')) return;
            const reader = new FileReader();
            reader.onload = e => {
                preview.src = e.target.result;
                preview.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        }

        // toast
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
                <text>showToast('@Html.Raw(Model.SuccessMessage)', 'success');</text>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
                <text>showToast('@Html.Raw(Model.ErrorMessage)', 'error');</text>
        }
    </script>

    <style>
        .drop-area {
            border: 2px dashed #ced4da;
            transition: .2s;
            cursor: pointer;
        }

            .drop-area.border-primary {
                border-color: var(--bs-primary);
                background: rgba(102,126,234,.05);
            }
    </style>
}