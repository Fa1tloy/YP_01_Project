@page
@model WebReckrytingSystem.Pages.Account.ChatModel
@{
    ViewData["Title"] = "Чаты";
}

<div class="container py-5 mt-5">
    <h1 class="h3 mb-4">Чаты</h1>

    <div class="row g-4">
        <div class="col-lg-4">
            <div id="conversationList" class="list-group shadow-sm">
                @if (!Model.Conversations.Any())
                {
                    <div class="list-group-item text-muted">Пока нет активных чатов.</div>
                }
                else
                {
                    @foreach (var convo in Model.Conversations)
                    {
                        var isActive = Model.Peer == convo.PeerEmail && Model.CompanyName == convo.VacancyCompanyName && Model.Title == convo.VacancyTitle;
                        <a class="list-group-item list-group-item-action @(isActive ? "active" : "")"
                               data-peer="@convo.PeerEmail"
                               data-company="@convo.VacancyCompanyName"
                               data-title="@convo.VacancyTitle"
                               href="javascript:void(0)">
                            <div class="d-flex align-items-start gap-2">
                                <img src="@convo.PeerAvatarUrl" alt="Аватар @convo.PeerEmail" class="rounded-circle flex-shrink-0" style="width: 40px; height: 40px; object-fit: cover;" />
                                <div class="chat-convo-text">
                                    <div class="fw-semibold">@convo.PeerEmail</div>
                                    <div class="small">@convo.VacancyTitle</div>
                                    <div class="small text-muted chat-convo-last-message">@convo.LastMessage</div>
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <div>
                        <div id="chatPeer" class="fw-semibold">@(Model.Peer ?? "Выберите чат")</div>
                        <div id="chatTitle" class="small text-muted">
                            @if (!string.IsNullOrWhiteSpace(Model.Title))
                            {
                                <text>Вакансия: @Model.Title</text>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Peer))
                    {
                        <form method="post" asp-page-handler="DeleteConversation"
                              onsubmit="return confirm('Удалить всю переписку с этим пользователем?');">
                            <input type="hidden" name="peer" value="@Model.Peer" />
                            <input type="hidden" name="companyName" value="@Model.CompanyName" />
                            <input type="hidden" name="title" value="@Model.Title" />
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill" title="Удалить чат">
                                <i class="fas fa-trash"></i> <span class="d-none d-md-inline">Удалить чат</span>
                            </button>
                        </form>
                    }
                </div>
                <div id="messagesContainer" class="card-body" style="max-height: 450px; overflow-y: auto;">
                    @if (!Model.Messages.Any())
                    {
                        <p class="text-muted mb-0">Сообщений пока нет.</p>
                    }
                    else
                    {
                        @foreach (var message in Model.Messages)
                        {
                            var isMine = message.SenderEmail == Model.CurrentUserEmail;
                            <div class="d-flex mb-3 @(isMine ? "justify-content-end" : "justify-content-start")">
                                <div class="chat-message-bubble p-2 rounded @(isMine ? "bg-primary text-white" : "bg-light")" style="max-width: 75%;">
                                    <div class="chat-message-text">@message.Message</div>
                                    <div class="chat-message-time small @(isMine ? "text-white-50" : "text-muted")">@FormatMskTime(message.SentAt)</div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="card-footer bg-transparent">
                    <form method="post" asp-page-handler="Send" class="d-flex gap-2" id="sendForm">
                        <input type="hidden" asp-for="Peer" id="hiddenPeer" />
                        <input type="hidden" asp-for="CompanyName" id="hiddenCompany" />
                        <input type="hidden" asp-for="Title" id="hiddenTitle" />
                        <textarea asp-for="MessageText" class="form-control chat-message-input" rows="1" placeholder="Введите сообщение..." id="messageInput"></textarea>
                        <button id="sendButton" type="submit" class="btn btn-primary" disabled>Отправить</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const conversationList = document.getElementById('conversationList');
            const messagesContainer = document.getElementById('messagesContainer');
            const chatPeer = document.getElementById('chatPeer');
            const chatTitle = document.getElementById('chatTitle');
            const hiddenPeer = document.getElementById('hiddenPeer');
            const hiddenCompany = document.getElementById('hiddenCompany');
            const hiddenTitle = document.getElementById('hiddenTitle');
            const sendButton = document.getElementById('sendButton');
            const sendForm = document.getElementById('sendForm');
            const messageInput = document.getElementById('messageInput');

            let currentPeer = hiddenPeer.value || '';
            let currentCompany = hiddenCompany.value || '';
            let currentTitle = hiddenTitle.value || '';

            let isUserScrolledUp = false;

            messagesContainer.addEventListener('scroll', () => {
                const threshold = 50;
                const distanceToBottom = messagesContainer.scrollHeight - messagesContainer.scrollTop - messagesContainer.clientHeight;
                isUserScrolledUp = distanceToBottom > threshold;
            });

            const escapeHtml = (text) => {
                const div = document.createElement('div');
                div.textContent = text ?? '';
                return div.innerHTML;
            };

                    const formatDate = (isoDate) => {
            const date = new Date(isoDate); // isoDate теперь с 'Z' – распознаётся как UTC
            return date.toLocaleString('ru-RU', {
                timeZone: 'Europe/Moscow',
                day: '2-digit',
                month: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            }).replace(',', '');
        };

            const renderConversations = (conversations) => {
                if (!conversationList) return;
                if (!conversations.length) {
                    conversationList.innerHTML = '<div class="list-group-item text-muted">Пока нет активных чатов.</div>';
                    return;
                }

                conversationList.innerHTML = conversations.map((convo) => {
                    const isActive = convo.peerEmail === currentPeer
                        && (convo.vacancyCompanyName || '') === (currentCompany || '')
                        && (convo.vacancyTitle || '') === (currentTitle || '');
                    return `
                        <a class="list-group-item list-group-item-action ${isActive ? 'active' : ''}"
                           data-peer="${escapeHtml(convo.peerEmail)}"
                           data-company="${escapeHtml(convo.vacancyCompanyName || '')}"
                           data-title="${escapeHtml(convo.vacancyTitle || '')}"
                           href="javascript:void(0)">
                            <div class="d-flex align-items-start gap-2">
                                <img src="${escapeHtml(convo.peerAvatarUrl || '/images/student.png')}" alt="Аватар ${escapeHtml(convo.peerEmail)}" class="rounded-circle flex-shrink-0" style="width: 40px; height: 40px; object-fit: cover;" />
                                <div class="chat-convo-text">
                                    <div class="fw-semibold">${escapeHtml(convo.peerEmail)}</div>
                                    <div class="small">${escapeHtml(convo.vacancyTitle || '')}</div>
                                    <div class="small text-muted chat-convo-last-message">${escapeHtml(convo.lastMessage || '')}</div>
                                </div>
                            </div>
                        </a>`;
                }).join('');

                document.querySelectorAll('#conversationList .list-group-item').forEach(item => {
                    item.addEventListener('click', (e) => {
                        e.preventDefault();
                        const peer = item.dataset.peer;
                        const company = item.dataset.company || '';
                        const title = item.dataset.title || '';
                        selectConversation(peer, company, title);
                    });
                });
            };

            const renderMessages = (messages, currentUserEmail) => {
                if (!messagesContainer) return;
                if (!messages.length) {
                    messagesContainer.innerHTML = '<p class="text-muted mb-0">Сообщений пока нет.</p>';
                    return;
                }

                messagesContainer.innerHTML = messages.map((message) => {
                    const isMine = message.senderEmail === currentUserEmail;
                    return `
                        <div class="d-flex mb-3 ${isMine ? 'justify-content-end' : 'justify-content-start'}">
                            <div class="chat-message-bubble p-2 rounded ${isMine ? 'bg-primary text-white' : 'bg-light'}" style="max-width: 75%;">
                                <div class="chat-message-text">${escapeHtml(message.message)}</div>
                                <div class="chat-message-time small ${isMine ? 'text-white-50' : 'text-muted'}">${formatDate(message.sentAt)}</div>
                            </div>
                        </div>`;
                }).join('');

                if (!isUserScrolledUp) {
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                }
            };

            const selectConversation = (peer, company, title) => {
                currentPeer = peer;
                currentCompany = company;
                currentTitle = title;
                hiddenPeer.value = peer;
                hiddenCompany.value = company;
                hiddenTitle.value = title;
                sendButton.disabled = false;
                chatPeer.textContent = peer;
                chatTitle.textContent = title ? `Вакансия: ${title}` : '';

                const params = new URLSearchParams();
                params.set('peer', peer);
                if (company) params.set('companyName', company);
                if (title) params.set('title', title);
                const newUrl = `${window.location.pathname}?${params.toString()}`;
                history.replaceState(null, '', newUrl);

                isUserScrolledUp = false;
                refreshChat();
            };

            const refreshChat = async () => {
                if (!currentPeer) return;

                const url = new URL(window.location.href);
                url.searchParams.set('handler', 'Updates');
                url.searchParams.set('peer', currentPeer);
                if (currentCompany) url.searchParams.set('companyName', currentCompany);
                if (currentTitle) url.searchParams.set('title', currentTitle);

                const response = await fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!response.ok) return;

                const data = await response.json();

                renderConversations(data.conversations || []);
                renderMessages(data.messages || [], data.currentUserEmail);

                if (!currentPeer && data.selectedPeer) {
                    selectConversation(data.selectedPeer, data.selectedCompanyName || '', data.selectedTitle || '');
                }

                sendButton.disabled = !currentPeer;
            };

            if (currentPeer) {
                selectConversation(currentPeer, currentCompany, currentTitle);
            } else {
                renderConversations([]);
            }

            setInterval(refreshChat, 5000);

            // AJAX отправка сообщения
            sendForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                if (!currentPeer || !messageInput.value.trim()) return;

                const formData = new FormData(sendForm);
                try {
                    const response = await fetch(sendForm.action, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: formData
                    });

                    if (!response.ok) throw new Error('Network response was not ok');

                    const result = await response.json();

                    if (result.success) {
                        const newMsg = result.message;
                        const msgHtml = `
                            <div class="d-flex mb-3 justify-content-end">
                                <div class="chat-message-bubble p-2 rounded bg-primary text-white" style="max-width: 75%;">
                                    <div class="chat-message-text">${escapeHtml(newMsg.message)}</div>
                                    <div class="chat-message-time small text-white-50">${formatDate(newMsg.sentAt)}</div>
                                </div>
                            </div>`;
                        messagesContainer.insertAdjacentHTML('beforeend', msgHtml);
                        messageInput.value = '';

                        if (!isUserScrolledUp) {
                            messagesContainer.scrollTop = messagesContainer.scrollHeight;
                        }
                    } else {
                        alert(result.error || 'Ошибка отправки');
                    }
                } catch (error) {
                    console.error('Ошибка отправки сообщения:', error);
                    alert('Не удалось отправить сообщение');
                }
            });

            // Отправка по Enter
            if (messageInput) {
                messageInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        if (sendButton && !sendButton.disabled && sendForm) {
                            sendForm.dispatchEvent(new Event('submit', { cancelable: true }));
                        }
                    }
                });
            }
        })();
    </script>

@functions {
    string FormatMskTime(DateTime dateTime)
    {
        var mskZone = TimeZoneInfo.FindSystemTimeZoneById("Russian Standard Time");
        var utcTime = DateTime.SpecifyKind(dateTime, DateTimeKind.Utc);
        var mskTime = TimeZoneInfo.ConvertTimeFromUtc(utcTime, mskZone);
        return mskTime.ToString("dd.MM HH:mm");
    }
}

    <style>
        .chat-message-input {
            resize: vertical;
            min-height: 2.25rem;
            max-height: 8rem;
            line-height: 1.35;
        }

        .chat-message-bubble {
            padding: 0.45rem 0.65rem !important;
        }

        .chat-message-text {
            margin: 0;
            line-height: 1.35;
            white-space: pre-line;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .chat-message-time {
            margin-top: 0.2rem;
            line-height: 1.2;
        }

        .chat-convo-text {
            min-width: 0;
            flex: 1 1 auto;
        }

        .chat-convo-last-message {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
        }
    </style>
}