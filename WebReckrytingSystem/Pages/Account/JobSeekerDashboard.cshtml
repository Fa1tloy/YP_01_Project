@page
@model WebReckrytingSystem.Pages.Account.JobSeekerDashboardModel
@{
    ViewData["Title"] = "Личный кабинет соискателя";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">Добро пожаловать, @Model.UserFirstName!</h5>
                    <p class="text-muted">Личный кабинет соискателя</p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h6>Быстрые действия</h6>
                    <div class="d-grid gap-2">
                        <a href="#" class="btn btn-outline-primary">Создать резюме</a>
                        <a href="#" class="btn btn-outline-primary">Найти вакансии</a>
                        <a href="#" class="btn btn-outline-primary">Мои отклики</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Статистика</h5>
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="border rounded p-3">
                                <h4 class="text-primary">0</h4>
                                <small>Откликов</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-3">
                                <h4 class="text-success">0</h4>
                                <small>Приглашений</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-3">
                                <h4 class="text-info">0</h4>
                                <small>Просмотров резюме</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title">Рекомендуемые вакансии</h5>
                    <p class="text-muted">Создайте резюме, чтобы увидеть подходящие вакансии</p>
                </div>
            </div>
        </div>
    </div>
</div>