@* Pages/Account/JobSeekerDashboard.cshtml *@
@page
@model WebReckrytingSystem.Pages.Account.JobSeekerDashboardModel
@{
    ViewData["Title"] = "Личный кабинет соискателя";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">Добро пожаловать, @Model.UserFirstName!</h5>
                    <p class="text-muted">Личный кабинет соискателя</p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h6>Быстрые действия</h6>
                    <div class="d-grid gap-2">
                        @if (Model.HasResume)
                        {
                            <a asp-page="/Account/ViewResume" class="btn btn-outline-primary">Мое резюме</a>
                            <a asp-page="/Account/EditResume" class="btn btn-outline-primary">Редактировать резюме</a>
                        }
                        else
                        {
                            <a asp-page="/Account/CreateResume" class="btn btn-outline-primary">Создать резюме</a>
                        }
                        <a href="#" class="btn btn-outline-primary">Найти вакансии</a>
                        <a href="#" class="btn btn-outline-primary">Мои отклики</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Статистика</h5>
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="border rounded p-3">
                                <h4 class="text-primary">0</h4>
                                <small>Откликов</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-3">
                                <h4 class="text-success">0</h4>
                                <small>Приглашений</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-3">
                                <h4 class="text-info">@(Model.HasResume ? "1" : "0")</h4>
                                <small>Резюме</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title">@(Model.HasResume ? "Ваше резюме" : "Создайте резюме")</h5>
                    @if (Model.HasResume)
                    {
                        <p class="text-success">✓ У вас есть опубликованное резюме</p>
                        <a asp-page="/Account/ViewResume" class="btn btn-primary">Просмотреть резюме</a>
                    }
                    else
                    {
                        <p class="text-muted">Создайте резюме, чтобы начать поиск работы</p>
                        <a asp-page="/Account/CreateResume" class="btn btn-primary">Создать резюме</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>