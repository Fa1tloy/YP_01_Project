@page
@model WebReckrytingSystem.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0" style="background: rgba(255,255,255,.85); backdrop-filter: blur(10px);">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-user-plus fa-3x text-primary mb-3"></i>
                        <h2 class="fw-bold">Создать аккаунт</h2>
                        <p class="text-muted">Начните путь к успеху за 60 секунд</p>
                    </div>

                    <form method="post" id="registerForm" novalidate>
                        <div asp-validation-summary="All" class="alert alert-danger rounded-pill"></div>

                        <div class="mb-3">
                            <label asp-for="RegisterData.Email" class="form-label fw-600"><i class="fas fa-envelope me-1"></i> Email</label>
                            <input asp-for="RegisterData.Email" class="form-control rounded-pill" placeholder="you@example.com" />
                            <span asp-validation-for="RegisterData.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterData.Password" class="form-label fw-600"><i class="fas fa-lock me-1"></i> Пароль</label>
                            <input asp-for="RegisterData.Password" type="password" class="form-control rounded-pill" placeholder="Минимум 8 символов" />
                            <span asp-validation-for="RegisterData.Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterData.ConfirmPassword" class="form-label fw-600"><i class="fas fa-redo me-1"></i> Подтвердите пароль</label>
                            <input asp-for="RegisterData.ConfirmPassword" type="password" class="form-control rounded-pill" />
                            <span asp-validation-for="RegisterData.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="RegisterData.FirstName" class="form-label fw-600"><i class="fas fa-user me-1"></i> Имя</label>
                                <input asp-for="RegisterData.FirstName" class="form-control rounded-pill" />
                                <span asp-validation-for="RegisterData.FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="RegisterData.LastName" class="form-label fw-600"><i class="fas fa-user me-1"></i> Фамилия</label>
                                <input asp-for="RegisterData.LastName" class="form-control rounded-pill" />
                                <span asp-validation-for="RegisterData.LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterData.Role" class="form-label fw-600"><i class="fas fa-users me-1"></i> Роль</label>
                            <select asp-for="RegisterData.Role" class="form-select rounded-pill" id="roleSelect">
                                <option value="">Выберите роль</option>
                                <option value="job_seeker">Соискатель</option>
                                <option value="employer">Работодатель</option>
                            </select>
                            <span asp-validation-for="RegisterData.Role" class="text-danger small"></span>
                        </div>

                        <div class="mb-4" id="companyField" style="display: none;">
                            <label asp-for="RegisterData.CompanyName" class="form-label fw-600"><i class="fas fa-building me-1"></i> Название компании</label>
                            <input asp-for="RegisterData.CompanyName" class="form-control rounded-pill" placeholder="ООО Ромашка" />
                            <span asp-validation-for="RegisterData.CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5">
                                <i class="fas fa-user-plus me-2"></i>Создать аккаунт
                            </button>
                        </div>

                        <div class="text-center mt-4">
                            <p class="mb-0">Уже есть аккаунт? <a href="/Account/Login" class="text-decoration-none">Войти</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // показ поля компании
        document.getElementById('roleSelect').addEventListener('change', e =>
            document.getElementById('companyField').style.display = e.target.value === 'employer' ? 'block' : 'none');

        // toast
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
                <text>showToast('@Html.Raw(Model.SuccessMessage)', 'success');</text>
        }
    </script>
}