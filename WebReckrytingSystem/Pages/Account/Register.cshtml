@page
@model WebReckrytingSystem.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация - Твоя Карьера";
}

<div class="register-page">
    <div class="register-container">
        <div class="register-card">
            <div class="register-form-section">
                <div class="brand text-center mb-4">
                    <h2 class="brand-name">Регистрация</h2>
                    <p class="brand-tagline">Начните карьеру за 60 секунд</p>
                </div>

                <form method="post" id="registerForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger @(ViewData.ModelState.ErrorCount > 0 ? "" : "d-none")"></div>

                    <input type="hidden" asp-for="RegisterData.Role" value="job_seeker" />

                    <div class="alert alert-info rounded-3 mb-4">
                        <i class="fas fa-info-circle me-2"></i>
                        Регистрация доступна только для соискателей. Компании и вакансии создает администратор платформы.
                    </div>

                    <!-- EMAIL -->
                    <div class="form-group mb-3">
                        <label asp-for="RegisterData.Email" class="form-label">
                            <i class="fas fa-envelope me-2"></i>Email
                        </label>
                        <input asp-for="RegisterData.Email" class="form-control form-control-lg" 
                               placeholder="you@example.com" required autocomplete="email" />
                        <span asp-validation-for="RegisterData.Email" class="text-danger small"></span>
                        <div class="email-check-feedback" style="display:none;"></div>
                    </div>

                    <!-- ИМЯ ФАМИЛИЯ -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="RegisterData.FirstName" class="form-label">
                                <i class="fas fa-user me-2"></i>Имя
                            </label>
                            <input asp-for="RegisterData.FirstName" class="form-control form-control-lg" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RegisterData.LastName" class="form-label">
                                <i class="fas fa-user me-2"></i>Фамилия
                            </label>
                            <input asp-for="RegisterData.LastName" class="form-control form-control-lg" required />
                        </div>
                    </div>

                    <!-- ПАРОЛИ -->
                    <div class="form-group mb-3">
                        <label asp-for="RegisterData.Password" class="form-label">
                            <i class="fas fa-lock me-2"></i>Пароль
                        </label>
                        <div class="input-group">
                            <input asp-for="RegisterData.Password" class="form-control form-control-lg" 
                                   placeholder="Минимум 8 символов" required />
                            <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="RegisterData.ConfirmPassword" class="form-label">
                            <i class="fas fa-redo me-2"></i>Подтвердите пароль
                        </label>
                        <input asp-for="RegisterData.ConfirmPassword" class="form-control form-control-lg" 
                               placeholder="Повторите пароль" required />
                    </div>

                    <!-- КНОПКА -->
                    <button type="submit" class="btn btn-success btn-lg w-100 mb-3">
                        <i class="fas fa-user-plus me-2"></i>Создать аккаунт
                    </button>

                    <div class="text-center">
                        <p class="mb-0">
                            Уже есть аккаунт?
                            <a asp-page="/Account/Login" class="fw-bold">Войти</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .register-page {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            padding: 2rem;
        }

        .register-container {
            max-width: 800px;
            margin: 0 auto;
            width: 100%;
        }

        .register-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            display: grid;
            grid-template-columns: 1fr;
            min-height: auto;
        }

        .register-form-section {
            padding: 3rem;
        }

        .brand-logo {
            height: 50px;
            margin-bottom: 1rem;
        }

        .brand-name {
            font-size: 1.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .brand-tagline {
            color: #6c757d;
        }

        @@media (max-width: 768px) {
            .register-page {
                padding: 1rem;
            }
            
            .register-form-section {
                padding: 2rem;
            }
        }


        :root[data-theme='dark'] .register-card {
            background: #1a1f29;
            color: #e9edf5;
            box-shadow: 0 20px 60px rgba(0,0,0,0.55);
        }

        :root[data-theme='dark'] .register-form-section {
            background: #1a1f29;
        }

        :root[data-theme='dark'] .brand-name {
            background: linear-gradient(135deg, #9fb2ff, #c7a6ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        :root[data-theme='dark'] .brand-tagline,
        :root[data-theme='dark'] .register-form-section p,
        :root[data-theme='dark'] .register-form-section .form-label {
            color: #dbe3f2;
        }

        :root[data-theme='dark'] .register-form-section .form-control {
            background-color: #ffffff;
            color: #212529;
            border-color: #cfd6e4;
        }

        :root[data-theme='dark'] .register-form-section .form-control:focus {
            background-color: #ffffff;
            color: #212529;
            border-color: #9fb2ff;
            box-shadow: 0 0 0 0.25rem rgba(159, 178, 255, 0.25);
        }

        :root[data-theme='dark'] .register-form-section .form-control::placeholder {
            color: #6c757d;
        }

        :root[data-theme='dark'] .register-form-section .btn-outline-secondary {
            background-color: #ffffff;
            color: #212529;
            border-color: #cfd6e4;
        }

        :root[data-theme='dark'] .register-form-section .alert-info {
            background-color: #202b3f;
            border-color: #3b5277;
            color: #dbeafe;
        }

        :root[data-theme='dark'] .register-form-section input:-webkit-autofill,
        :root[data-theme='dark'] .register-form-section input:-webkit-autofill:hover,
        :root[data-theme='dark'] .register-form-section input:-webkit-autofill:focus {
            -webkit-text-fill-color: #212529;
            box-shadow: 0 0 0 1000px #ffffff inset;
        }
        .btn-check:checked + .btn-outline-primary {
            background-color: #667eea;
            border-color: #667eea;
            color: white;
        }

        .btn-check:checked + .btn-outline-success {
            background-color: #28a745;
            border-color: #28a745;
            color: white;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Переключатель пароля
        document.getElementById('togglePassword').addEventListener('click', function() {
            const passwordInput = document.querySelector('input[name="RegisterData.Password"]');
            const icon = this.querySelector('i');
            
            passwordInput.type = passwordInput.type === 'password' ? 'text' : 'password';
            icon.classList.toggle('fa-eye');
            icon.classList.toggle('fa-eye-slash');
        });

        let emailTimeout;
        document.querySelector('input[name="RegisterData.Email"]').addEventListener('input', function() {
            clearTimeout(emailTimeout);
            const email = this.value.trim();
            const feedback = document.querySelector('.email-check-feedback');
            
            // Проверяем длину и наличие символа (без includes)
            if (email.length > 3 && email.indexOf('@@') > -1) { // ИСПРАВЛЕНО: используем indexOf
                emailTimeout = setTimeout(async () => {
                    try {
                        const response = await fetch('/Account/Register?handler=CheckEmail', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify(email)
                        });
                        
                        const result = await response.json();
                        
                        feedback.style.display = 'block';
                        if (result.exists) {
                            feedback.innerHTML = '<i class="fas fa-times-circle me-1"></i> Email уже занят';
                            feedback.className = 'email-check-feedback text-danger small mt-1';
                        } else {
                            feedback.innerHTML = '<i class="fas fa-check-circle me-1"></i> Email доступен';
                            feedback.className = 'email-check-feedback text-success small mt-1';
                        }
                    } catch (error) {
                        feedback.style.display = 'none';
                    }
                }, 500);
            } else {
                feedback.style.display = 'none';
            }
        });

        // Автоочистка ошибок
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert.alert-danger');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 8000);
    </script>
}
