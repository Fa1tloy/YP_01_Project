@page
@model WebReckrytingSystem.Pages.Account.FavoritesModel
@{
    ViewData["Title"] = "Избранное";
}

<div class="container py-5 mt-5">
    <h1 class="h3 mb-4">Избранное</h1>

    @if (!string.IsNullOrEmpty(TempData["SuccessMessage"]?.ToString()))
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (User.IsInRole("job_seeker"))
    {
        if (Model.SavedVacancies.Any())
        {
            <div class="list-group">
                @foreach (var item in Model.SavedVacancies)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-start">
                        <a asp-page="/Vacancy/Details" asp-route-companyName="@item.Vacancy?.CompanyName" asp-route-title="@item.Vacancy?.Title" class="text-decoration-none flex-grow-1 me-3">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">@(item.Vacancy?.Title ?? "Без названия")</h5>
                                <small>@item.SavedAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                            </div>
                            <p class="mb-1">@(item.Vacancy?.CompanyName ?? "")</p>
                        </a>
                        <form method="post" asp-page-handler="DeleteVacancy" class="d-inline" onsubmit="return confirm('Удалить вакансию из избранного?')">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Удалить из избранного">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">Нет сохранённых вакансий.</p>
        }
    }
    else if (User.IsInRole("employer"))
    {
        if (Model.SavedResumes.Any())
        {
            <div class="list-group">
                @foreach (var item in Model.SavedResumes)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-start">
                        <a asp-page="/Resume/Details" asp-route-userEmail="@item.Resume?.UserEmail" class="text-decoration-none flex-grow-1 me-3">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">@(item.Resume?.DesiredPosition ?? "Без названия")</h5>
                                <small>@item.SavedAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                            </div>
                            <p class="mb-1">@(item.Resume?.User?.FirstName) @(item.Resume?.User?.LastName)</p>
                        </a>
                        <form method="post" asp-page-handler="DeleteResume" class="d-inline" onsubmit="return confirm('Удалить резюме из избранного?')">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Удалить из избранного">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">Нет сохранённых резюме.</p>
        }
    }
</div>