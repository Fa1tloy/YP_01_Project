@page
@model WebReckrytingSystem.Pages.Account.EditResumeModel
@{
    ViewData["Title"] = "Редактирование резюме";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="fas fa-edit me-2"></i>Редактирование резюме
                    </h4>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success">
                            @Model.SuccessMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @Model.ErrorMessage
                        </div>
                    }

                    <form method="post" id="resumeForm">
                        <div class="row">
                            <!-- Основная информация -->
                            <div class="col-md-6">
                                <h5 class="border-bottom pb-2">Основная информация</h5>

                                <div class="mb-3">
                                    <label asp-for="ResumeData.DesiredPosition" class="form-label">Желаемая должность *</label>
                                    <input asp-for="ResumeData.DesiredPosition" class="form-control" placeholder="Например, .NET Developer" />
                                    <span asp-validation-for="ResumeData.DesiredPosition" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ResumeData.SalaryExpectations" class="form-label">Зарплатные ожидания (руб.)</label>
                                    <input asp-for="ResumeData.SalaryExpectations" type="number" class="form-control" placeholder="Например, 100000" min="0" max="9999999" />
                                    <span asp-validation-for="ResumeData.SalaryExpectations" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ResumeData.ExperienceYears" class="form-label">Опыт работы (лет)</label>
                                    <input asp-for="ResumeData.ExperienceYears" type="number" class="form-control" placeholder="Например, 3" min="0" max="60" />
                                    <span asp-validation-for="ResumeData.ExperienceYears" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ResumeData.ExperienceDescription" class="form-label">Описание опыта работы</label>
                                    <textarea asp-for="ResumeData.ExperienceDescription" class="form-control" rows="3" placeholder="Опишите ваш опыт работы, ключевые проекты и достижения"></textarea>
                                    <span asp-validation-for="ResumeData.ExperienceDescription" class="text-danger"></span>
                                    <small class="form-text text-muted">Максимум 1000 символов</small>
                                </div>
                            </div>

                            <!-- Образование и навыки -->
                            <div class="col-md-6">
                                <h5 class="border-bottom pb-2">Образование</h5>

                                <div class="mb-3">
                                    <label asp-for="ResumeData.EducationalInstitution" class="form-label">Учебное заведение *</label>
                                    <input asp-for="ResumeData.EducationalInstitution" class="form-control" placeholder="Например, МГУ им. Ломоносова" />
                                    <span asp-validation-for="ResumeData.EducationalInstitution" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ResumeData.Faculty" class="form-label">Факультет</label>
                                    <input asp-for="ResumeData.Faculty" class="form-control" placeholder="Например, Факультет вычислительной математики и кибернетики" />
                                    <span asp-validation-for="ResumeData.Faculty" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ResumeData.Specialization" class="form-label">Специализация</label>
                                    <input asp-for="ResumeData.Specialization" class="form-control" placeholder="Например, Прикладная математика и информатика" />
                                    <span asp-validation-for="ResumeData.Specialization" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ResumeData.GraduationYear" class="form-label">Год окончания</label>
                                    <input asp-for="ResumeData.GraduationYear" type="number" class="form-control" placeholder="Например, 2023" min="1900" max="2025" />
                                    <span asp-validation-for="ResumeData.GraduationYear" class="text-danger"></span>
                                </div>

                                <h5 class="border-bottom pb-2 mt-4">Ключевые навыки</h5>

                                <div class="mb-3">
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="newSkillInput" placeholder="Например, C#, ASP.NET, SQL" />
                                        <button type="button" class="btn btn-outline-primary" id="addSkillBtn">Добавить</button>
                                    </div>
                                    <div id="skillsError" class="text-danger small"></div>
                                    <small class="form-text text-muted">Добавьте хотя бы один навык. Максимум 20 навыков.</small>
                                </div>

                                <div class="mb-3">
                                    <div id="skillsList" class="d-flex flex-wrap gap-2">
                                        @foreach (var skill in Model.ResumeData.Skills)
                                        {
                                            <span class="badge bg-primary skill-badge">
                                                @skill
                                                <button type="button" class="btn-close btn-close-white ms-1" data-skill="@skill"></button>
                                            </span>
                                        }
                                    </div>
                                    <input type="hidden" asp-for="ResumeData.Skills" id="skillsHidden" />
                                </div>
                            </div>
                        </div>

                        <!-- Публикация -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="ResumeData.IsPublished" class="form-check-input" />
                                    <label asp-for="ResumeData.IsPublished" class="form-check-label">Опубликовать резюме (сделать видимым для работодателей)</label>
                                </div>
                            </div>
                        </div>

                        <!-- Кнопки -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-warning">
                                        <i class="fas fa-save"></i> Сохранить изменения
                                    </button>
                                    <a href="/Account/ViewResume" class="btn btn-secondary">Отмена</a>
                                    <a href="/Account/JobSeekerDashboard" class="btn btn-outline-secondary">В кабинет</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const skills = @Html.Raw(Json.Serialize(Model.ResumeData.Skills));
            updateSkillsHiddenInput();

            // Добавление навыка
            document.getElementById('addSkillBtn').addEventListener('click', addSkill);
            document.getElementById('newSkillInput').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    addSkill();
                }
            });

            // Удаление навыка
            document.addEventListener('click', function(e) {
                if (e.target.classList.contains('btn-close')) {
                    const skill = e.target.getAttribute('data-skill');
                    removeSkill(skill);
                }
            });

            function addSkill() {
                const input = document.getElementById('newSkillInput');
                const skill = input.value.trim();
                const errorDiv = document.getElementById('skillsError');

                if (!skill) {
                    errorDiv.textContent = 'Введите название навыка';
                    return;
                }

                if (skills.length >= 20) {
                    errorDiv.textContent = 'Максимум 20 навыков';
                    return;
                }

                if (skills.includes(skill)) {
                    errorDiv.textContent = 'Этот навык уже добавлен';
                    return;
                }

                skills.push(skill);
                renderSkills();
                input.value = '';
                errorDiv.textContent = '';
            }

            function removeSkill(skill) {
                const index = skills.indexOf(skill);
                if (index > -1) {
                    skills.splice(index, 1);
                    renderSkills();
                }
            }

            function renderSkills() {
                const skillsList = document.getElementById('skillsList');
                skillsList.innerHTML = '';

                skills.forEach(skill => {
                    const badge = document.createElement('span');
                    badge.className = 'badge bg-primary skill-badge';
                    badge.innerHTML = `
                        ${skill}
                        <button type="button" class="btn-close btn-close-white ms-1" data-skill="${skill}"></button>
                    `;
                    skillsList.appendChild(badge);
                });

                updateSkillsHiddenInput();
            }

            function updateSkillsHiddenInput() {
                document.getElementById('skillsHidden').value = skills.join(',');
            }
        });
    </script>

    <style>
        .skill-badge {
            font-size: 0.875rem;
            padding: 0.5em 0.75em;
        }
        .btn-close {
            font-size: 0.7rem;
        }
        .card-header.bg-warning {
            background-color: #ffc107 !important;
        }
    </style>
}