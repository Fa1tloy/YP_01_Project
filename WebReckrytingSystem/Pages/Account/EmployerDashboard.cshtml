@page
@using WebReckrytingSystem.Helpers
@model WebReckrytingSystem.Pages.Account.EmployerDashboardModel
@{
    ViewData["Title"] = "Личный кабинет работодателя";
}

<div class="container-fluid dashboard-page px-5 px-xl-5">
    <!-- ЗАГОЛОВОК -->
    <div class="dashboard-header">
        <div class="user-info">
            <img src="@Model.UserAvatarUrl" alt="Аватар работодателя" class="user-avatar" />
            <div>
                <h1>Привет, <span class="gradient-text">@Model.UserFirstName</span>!</h1>
                <p class="text-muted mb-0">Работодатель</p>
                <p class="text-muted small">@Model.UserEmail</p>
            </div>
        </div>
        <div class="quick-actions">
            <a href="/Company/Settings" class="btn btn-outline-light me-2">
                <i class="fas fa-cog me-2"></i>Моя компания
            </a>
            <a href="/Vacancy/Create" class="btn btn-success">
                <i class="fas fa-briefcase me-2"></i>Создать вакансию
            </a>
        </div>
    </div>

    <!-- СТАТИСТИКА -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 stat-card">
                <div class="card-body text-center">
                    <i class="fas fa-briefcase fa-2x text-primary mb-2"></i>
                    <h3 class="fw-bold">@Model.TotalVacancies</h3>
                    <p class="text-muted mb-0">Всего вакансий</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 stat-card">
                <div class="card-body text-center">
                    <i class="fas fa-paper-plane fa-2x text-success mb-2"></i>
                    <h3 class="fw-bold">@Model.TotalResponses</h3>
                    <p class="text-muted mb-0">Всего откликов</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 stat-card">
                <div class="card-body text-center">
                    <i class="fas fa-clock fa-2x text-warning mb-2"></i>
                    <h3 class="fw-bold">@Model.NewResponses</h3>
                    <p class="text-muted mb-0">Новые отклики</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 stat-card">
                <div class="card-body text-center">
                    <i class="fas fa-eye fa-2x text-info mb-2"></i>
                    <h3 class="fw-bold">@Model.ViewsThisWeek</h3>
                    <p class="text-muted mb-0">Просмотров за неделю</p>
                </div>
            </div>
        </div>
    </div>

    <!-- МОИ ВАКАНСИИ -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-600">
                <i class="fas fa-briefcase me-2 text-primary"></i>Мои вакансии
            </h5>
            <a href="/Vacancy/Create" class="btn btn-sm btn-outline-success">
                <i class="fas fa-plus me-1"></i>Добавить вакансию
            </a>
        </div>
        <div class="card-body">
            @if (Model.Vacancies.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Должность</th>
                                <th>Компания</th>
                                <th>Зарплата</th>
                                <th>Тип</th>
                                <th>Отклики</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vacancyWithStats in Model.Vacancies)
                            {
                                var vacancy = vacancyWithStats.Vacancy;
                                var responseCount = vacancyWithStats.ResponseCount;

                                <tr>
                                    <td>
                                        <strong>@vacancy.Title</strong>
                                        <br><small class="text-muted">@ViewHelper.GetEmploymentTypeDisplay(vacancy.EmploymentType)</small>
                                    </td>
                                    <td>@vacancy.CompanyName</td>
                                    <td>
                                        @if (vacancy.SalaryFrom.HasValue)
                                        {
                                            <span class="text-success fw-600">от @vacancy.SalaryFrom.Value.ToString("N0") ₽</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Не указана</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light">@ViewHelper.GetWorkScheduleDisplay(vacancy.WorkSchedule)</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary rounded-pill">@responseCount</span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="/Vacancy/Edit/@Uri.EscapeDataString(vacancy.CompanyName)/@Uri.EscapeDataString(vacancy.Title)"
                                               class="btn btn-outline-primary" title="Редактировать">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="/Vacancy/Details/@Uri.EscapeDataString(vacancy.CompanyName)/@Uri.EscapeDataString(vacancy.Title)"
                                               class="btn btn-outline-info" title="Просмотреть">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-briefcase fa-3x text-muted mb-3"></i>
                    <h6>У вас пока нет вакансий</h6>
                    <p class="text-muted mb-3">Создайте первую вакансию, чтобы начать поиск сотрудников</p>
                    <a href="/Vacancy/Create" class="btn btn-primary rounded-pill">
                        <i class="fas fa-plus me-2"></i>Создать вакансию
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- ПОСЛЕДНИЕ ОТКЛИКИ -->
    <div id="recentApplicationsSection" class="card shadow-sm">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-600">
                <i class="fas fa-paper-plane me-2 text-success"></i>Последние отклики
            </h5>
            <a href="#recentApplicationsSection" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-list me-1"></i>Все отклики
            </a>
        </div>
        <div class="card-body">
            @if (Model.RecentApplications.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Вакансия</th>
                                <th>Кандидат</th>
                                <th>Email</th>
                                <th>Статус</th>
                                <th>Дата</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model.RecentApplications)
                            {
                                <tr>
                                    <td><strong>@app.VacancyTitle</strong></td>
                                    <td>@app.StudentName</td>
                                    <td><small>@app.StudentEmail</small></td>
                                    <td>
                                        <span class="badge bg-@GetStatusBadgeColor(app.Status) rounded-pill">
                                            @EmployerDashboardHelper.GetStatusDisplay(app.Status)
                                        </span>
                                    </td>
                                    <td><small>@app.AppliedAt</small></td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="/Resume/View/@Uri.EscapeDataString(app.StudentEmail)"
                                               class="btn btn-outline-primary" title="Резюме">
                                                <i class="fas fa-file-alt"></i>
                                            </a>
                                            <a href="mailto:@app.StudentEmail"
                                               class="btn btn-outline-success" title="Написать">
                                                <i class="fas fa-envelope"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-inbox fa-2x text-muted mb-3"></i>
                    <p class="text-muted mb-0">Пока нет откликов на ваши вакансии</p>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .dashboard-page {
            padding-top: 104px;
            padding-left: 2rem;
            padding-right: 2rem;
        }

        .dashboard-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem;
            border-radius: 20px;
            margin-bottom: 2rem;
        }

        .user-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #667eea;
        }

            .dashboard-header .user-info {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

            .dashboard-header .quick-actions {
                display: flex;
                gap: 0.5rem;
            }

        .stat-card {
            transition: transform 0.3s ease;
        }

            .stat-card:hover {
                transform: translateY(-5px);
            }

        .table-responsive {
            border-radius: 10px;
            overflow: hidden;
        }

        .table-responsive {
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch;
        }

        @@media (max-width: 768px) {
            .dashboard-page {
                padding-top: 112px;
            }

            .table-responsive table {
                min-width: 700px; /* При необходимости увеличьте значение */
            }

            .dashboard-header {
                flex-direction: column;
                text-align: center;
            }

                .dashboard-header .quick-actions {
                    margin-top: 1rem;
                    width: 100%;
                    justify-content: center;
                }
        }

        :root[data-theme='dark'] .table {
            --bs-table-bg: #1a1f29;
            --bs-table-color: #e9edf5;
            --bs-table-border-color: #2d3442;
            --bs-table-striped-bg: #212838;
            --bs-table-hover-bg: #242c3b;
            --bs-table-hover-color: #ffffff;
            color: #e9edf5;
        }

        :root[data-theme='dark'] .table td,
        :root[data-theme='dark'] .table th {
            background-color: transparent !important;
            color: inherit;
        }

        :root[data-theme='dark'] .table .bg-light {
            background-color: #2a3345 !important;
            color: #e9edf5 !important;
        }
    </style>
}

@section Scripts {
    <script>
        // Обновление страницы каждые 30 секунд для актуализации данных
        setInterval(() => {
            location.reload();
        }, 30000);
    </script>
}

@functions {
    string GetStatusBadgeColor(string status) => status switch
    {
        "hired" => "success",
        "rejected" => "danger",
        "interview" => "warning",
        _ => "secondary"
    };
}
