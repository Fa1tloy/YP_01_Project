@page
@model WebReckrytingSystem.Pages.Account.EmployerDashboardModel
@{
    ViewData["Title"] = "Личный кабинет работодателя";
}

<div class="container mt-5">
    <!-- toast -->
    @if (TempData["SuccessMessage"] != null)
    {
        <script>showToast('@Html.Raw(TempData["SuccessMessage"])', 'success');</script>
    }

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-lg border-0 text-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff;">
                <div class="card-body py-5">
                    <i class="fas fa-user-tie fa-3x mb-3"></i>
                    <h4>@Model.UserFirstName</h4>
                    <p class="mb-0">Работодатель</p>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Быстрые действия</h6>
                    <div class="d-grid gap-2">
                        <a href="/Company/Create" class="btn btn-outline-primary rounded-pill">
                            <i class="fas fa-plus me-2"></i>Создать компанию
                        </a>
                        <a href="/Vacancy/Create" class="btn btn-outline-primary rounded-pill">
                            <i class="fas fa-briefcase me-2"></i>Создать вакансию
                        </a>
                        <a href="/Vacancy/Search" class="btn btn-outline-primary rounded-pill">
                            <i class="fas fa-search me-2"></i>Найти резюме
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <!-- Статистика -->
            <div class="row g-4 text-center mb-4">
                <div class="col-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="display-6 fw-bold text-primary">@Model.ActiveVacanciesCount</div>
                            <div class="text-muted">Вакансий</div>
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="display-6 fw-bold text-success">0</div>
                            <div class="text-muted">Откликов</div>
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="display-6 fw-bold text-info">0</div>
                            <div class="text-muted">Приглашений</div>
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="display-6 fw-bold text-warning">0</div>
                            <div class="text-muted">Наймов</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Мои вакансии -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-600">Мои вакансии</h5>
                    <span class="badge bg-primary rounded-pill">@Model.Vacancies.Count</span>
                </div>
                <div class="card-body">
                    @if (Model.Vacancies.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var v in Model.Vacancies)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <h6 class="mb-1">@v.Title</h6>
                                        <small class="text-muted">@v.CompanyName</small>
                                    </div>
                                    <div class="d-flex gap-2 align-items-center">
                                        <span class="badge bg-light text-dark">@GetEmploymentTypeDisplay(v.EmploymentType)</span>
                                        <a href="/Vacancy/Edit/@Uri.EscapeDataString(v.CompanyName)/@Uri.EscapeDataString(v.Title)" class="btn btn-sm btn-outline-primary rounded-pill">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-briefcase fa-3x text-muted mb-3"></i>
                            <h6>У вас пока нет вакансий</h6>
                            <p class="text-muted mb-3">Создайте первую вакансию, чтобы начать поиск сотрудников</p>
                            <a href="/Vacancy/Create" class="btn btn-primary rounded-pill">Создать вакансию</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetEmploymentTypeDisplay(string employmentType)
    {
        return employmentType switch
        {
            "full" => "Полная",
            "part" => "Частичная",
            "project" => "Проектная",
            "internship" => "Стажировка",
            "volunteer" => "Волонтёрство",
            _ => employmentType
        };
    }
}