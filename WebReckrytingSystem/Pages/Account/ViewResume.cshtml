@page
@model WebReckrytingSystem.Pages.Account.ViewResumeModel
@{
    ViewData["Title"] = "Моё резюме";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold">Моё резюме</h2>
                <div>
                    <a href="/Account/EditResume" class="btn btn-outline-primary me-2 rounded-pill">
                        <i class="fas fa-edit"></i> Редактировать
                    </a>
                    <a href="/Account/JobSeekerDashboard" class="btn btn-secondary rounded-pill">
                        <i class="fas fa-arrow-left"></i> В кабинет
                    </a>
                </div>
            </div>

            @if (Model.Resume != null)
            {
                <!-- Статус -->
                <div class="alert @(Model.Resume.IsPublished ? "alert-success" : "alert-warning") d-flex align-items-center mb-4 rounded-pill">
                    <i class="fas @(Model.Resume.IsPublished ? "fa-eye" : "fa-eye-slash") me-2"></i>
                    <div>
                        <strong>@(Model.Resume.IsPublished ? "Опубликовано" : "Черновик")</strong>
                        <br /><small>@(Model.Resume.IsPublished ? "Видно всем работодателям" : "Только вам")</small>
                    </div>
                </div>

                <!-- Основная карточка -->
                <div class="card shadow-lg border-0 mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff;">
                    <div class="card-body text-center py-5">
                        <h3 class="fw-bold mb-2">@Model.Resume.DesiredPosition</h3>
                        @if (Model.Resume.SalaryExpectations.HasValue)
                        {
                            <h4 class="mb-0">@Model.Resume.SalaryExpectations.Value.ToString("N0") ₽</h4>
                        }
                    </div>
                </div>

                <!-- Опыт -->
                @if (!string.IsNullOrEmpty(Model.Resume.ExperienceDescription))
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-transparent">
                            <h5 class="mb-0"><i class="fas fa-briefcase me-2 text-primary"></i>Опыт работы</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-0" style="white-space: pre-line">@Model.Resume.ExperienceDescription</p>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Resume.PracticesJson))
                {
                    var practices = System.Text.Json.JsonSerializer.Deserialize<List<WebReckrytingSystem.Models.PracticeViewModel>>(Model.Resume.PracticesJson);
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-transparent">
                            <h5 class="mb-0"><i class="fas fa-briefcase me-2 text-info"></i>Практики</h5>
                        </div>
                        <div class="card-body">
                            <ul class="mb-0">
                                @foreach (var p in practices!)
                                {
                                    <li>
                                        <strong>@p.Place</strong>
                                        <span class="text-muted">(@p.StartDate.ToString("MMM yyyy") – @p.EndDate.ToString("MMM yyyy"))</span>
                                        @if (!string.IsNullOrWhiteSpace(p.Description))
                                        {
                                            <br />
                            
                                            <small>@p.Description</small>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <!-- Образование -->
                @if (!string.IsNullOrEmpty(Model.Resume.EducationDescription))
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-transparent">
                            <h5 class="mb-0"><i class="fas fa-graduation-cap me-2 text-success"></i>Образование</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-0" style="white-space: pre-line">@Model.Resume.EducationDescription</p>
                        </div>
                    </div>
                }

              
                @if (!string.IsNullOrWhiteSpace(Model.Resume.Skills))
                {
                    var skills = Model.Resume.Skills
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(s => !string.IsNullOrWhiteSpace(s));

                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-transparent">
                            <h5 class="mb-0"><i class="fas fa-tools me-2 text-info"></i>Ключевые навыки</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var skill in skills)
                                {
                                    <span class="badge bg-primary fs-6 py-2 px-3 rounded-pill">@skill</span>
                                }
                            </div>
                        </div>
                    </div>
                }


                <!-- Готово к работе -->
                @if (Model.Resume.IsPublished)
                {
                    <div class="card border-success shadow-sm text-center">
                        <div class="card-body">
                            <h5 class="text-success mb-0">
                                <i class="fas fa-check-circle me-2"></i>Готово к работе!
                            </h5>
                            <p class="text-muted mb-0 mt-2">Ваше резюме видно работодателям. Ожидайте приглашений!</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-file-alt fa-4x text-muted mb-3"></i>
                    <h3>Резюме не найдено</h3>
                    <p class="text-muted mb-4">Создайте ваше первое резюме, чтобы начать поиск работы</p>
                    <a href="/Account/CreateResume" class="btn btn-primary btn-lg rounded-pill">
                        <i class="fas fa-plus me-2"></i>Создать резюме
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
                <text>showToast('@Html.Raw(Model.SuccessMessage)', 'success');</text>
        }
    </script>
}