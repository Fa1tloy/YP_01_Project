@page
@model WebReckrytingSystem.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-lg border-0" style="background: rgba(255,255,255,.85); backdrop-filter: blur(10px);">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-sign-in-alt fa-3x text-primary mb-3"></i>
                        <h2 class="fw-bold">Вход</h2>
                        <p class="text-muted">Добро пожаловать обратно!</p>
                    </div>

                    <form method="post" id="loginForm" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-pill"></div>

                        <div class="mb-3">
                            <label asp-for="LoginData.Email" class="form-label fw-600"><i class="fas fa-envelope me-1"></i> Email</label>
                            <input asp-for="LoginData.Email" class="form-control rounded-pill" placeholder="you@example.com" />
                            <span asp-validation-for="LoginData.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LoginData.Password" class="form-label fw-600"><i class="fas fa-lock me-1"></i> Пароль</label>
                            <input asp-for="LoginData.Password" type="password" class="form-control rounded-pill" placeholder="Пароль" />
                            <span asp-validation-for="LoginData.Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="LoginData.RememberMe" class="form-check-input" />
                            <label asp-for="LoginData.RememberMe" class="form-check-label"> Запомнить меня</label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5">
                                <i class="fas fa-sign-in-alt me-2"></i>Войти
                            </button>
                        </div>

                        <div class="text-center mt-4">
                            <p class="mb-0">Нет аккаунта? <a href="/Account/Register" class="text-decoration-none">Создать</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // toast
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
                <text>showToast('@Html.Raw(Model.ErrorMessage)', 'error');</text>
        }
    </script>
}