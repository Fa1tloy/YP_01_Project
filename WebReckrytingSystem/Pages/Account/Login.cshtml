@page
@model WebReckrytingSystem.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-center mb-4">Вход в систему</h2>

            <!-- Блок для отображения ошибок -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    @Model.ErrorMessage
                </div>
            }

            <!-- Валидационные ошибки -->
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <form method="post">
                <div class="mb-3">
                    <label asp-for="LoginData.Email" class="form-label">Email</label>
                    <input asp-for="LoginData.Email" class="form-control" />
                    <span asp-validation-for="LoginData.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LoginData.Password" class="form-label">Пароль</label>
                    <input asp-for="LoginData.Password" type="password" class="form-control" />
                    <span asp-validation-for="LoginData.Password" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="LoginData.RememberMe" class="form-check-input" />
                    <label asp-for="LoginData.RememberMe" class="form-check-label">Запомнить меня</label>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Войти</button>
                </div>
            </form>

            <div class="text-center mt-3">
                <p>Нет аккаунта? <a href="/Account/Register">Зарегистрироваться</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}